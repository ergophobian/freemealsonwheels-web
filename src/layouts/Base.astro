---
interface Props { title: string; description?: string; immersive?: boolean }
const { title, immersive = false, description = 'Free Meals on Wheels cooks and delivers free, fresh meals to neighbors in need across the Bay Area.' } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  ['/about', 'About'],
  ['/programs', 'Programs'],
  ['/volunteer', 'Volunteer'],
  ['/resources', 'Resources'],
  ['/contact', 'Contact'],
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title === 'Home' ? 'Free Meals on Wheels' : `${title} · Free Meals on Wheels`}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/logo.png" />
  <script is:inline>if (new URLSearchParams(location.search).has('embed')) document.documentElement.classList.add('embed');</script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body class:list={[{ immersive }]}>
  {!immersive && <header class="site-header">
    <div class="wrap bar">
      <a href="/" class="brand"><img src="/logo.png" alt="" width="36" height="36" /> Free Meals on Wheels</a>
      <input type="checkbox" id="menu" class="menu-toggle" aria-label="Open menu" />
      <label for="menu" class="menu-btn" aria-hidden="true"><span></span></label>
      <nav>
        {nav.map(([href, label]) => <a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>)}
        <a href="/donate" class="btn btn-sm">Donate</a>
      </nav>
    </div>
  </header>}
  <main><slot /></main>
  {!immersive && <footer class="site-footer">
    <div class="wrap footer-grid">
      <div>
        <img src="/img/logo-banner.png" alt="Free Meals on Wheels" width="220" style="margin-bottom:12px" />
        <p class="muted">Bringing smiles, one meal at a time. A 501(c)(3) nonprofit with kitchens in San Jose and San Ramon.</p>
      </div>
      <div>
        <h4>Get involved</h4>
        <a href="/donate">Donate</a><a href="/volunteer">Volunteer</a><a href="/programs">Programs</a>
      </div>
      <div>
        <h4>Say hello</h4>
        <a href="mailto:info@freemealsonwheels.com">info@freemealsonwheels.com</a>
        <a href="https://www.instagram.com/freemealsonwheels/">Instagram</a>
        <a href="https://www.facebook.com/Freemeals20/">Facebook</a>
      </div>
    </div>
    <p class="wrap muted small">© {new Date().getFullYear()} Free Meals on Wheels. Every dollar goes to meals.</p>
  </footer>}
</body>
</html>

<style is:global>
  html.embed .site-header, html.embed .site-footer { display: none; }
  html.embed body { background: transparent; }
  html.embed main > .page-hero:first-child { padding-top: 28px; }
  :root {
    /* Brand: deep forest green carries the page, orange is reserved for actions, gold from the logo ties them. */
    --green: #1f4d34; --green-2: #2f6b4a; --orange: #e8681c; --gold: #e2c27a; --cream: #fbf6ee;
    --ink: #17271e; --muted: #5b6b61; --line: rgb(31 77 52 / .12);
    --brand: var(--orange); --brand-ink: #fff; --accent: var(--green);
    --tint: rgb(31 77 52 / .07); --tint-2: rgb(31 77 52 / .14);
    --bg: var(--cream); --surface: rgb(255 255 255 / .78); --soft: #f3ecdf;
    --glass-line: rgb(255 255 255 / .9);
    --radius: 22px;
    --shadow: 0 1px 2px rgb(31 50 40 / .06), 0 14px 40px -12px rgb(31 50 40 / .22);
    --btn: linear-gradient(180deg, #f27a2e, #e8681c 60%, #d65a12);
    --btn-shadow: inset 0 1px 0 rgb(255 255 255 / .28), 0 4px 12px -4px rgb(214 90 18 / .5);
  }
  @media (prefers-color-scheme: dark) {
    :root { --ink: #eef3ee; --muted: #a9b8ad; --line: rgb(255 255 255 / .1); --accent: #8fd1a8; --tint: rgb(143 209 168 / .1); --tint-2: rgb(143 209 168 / .2);
      --bg: #0f1a14; --surface: rgb(30 44 36 / .7); --soft: #15241b; --glass-line: rgb(255 255 255 / .08); }
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; background: var(--bg); color: var(--ink); font: 400 17px/1.6 Inter, system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
  h1, h2, h3 { color: var(--accent); font-weight: 650; line-height: 1.08; letter-spacing: -.03em; margin: 0 0 .5em; }
  h1 { font-size: clamp(2.4rem, 6vw, 4.2rem); }
  h2 { font-size: clamp(1.8rem, 4vw, 2.6rem); }
  h3 { font-size: 1.3rem; }
  h4 { font-size: .95rem; margin: 0 0 .6rem; color: var(--muted); font-weight: 600; }
  a { color: inherit; }
  img { max-width: 100%; display: block; }
  .wrap { width: min(1120px, 100% - 32px); margin-inline: auto; }
  .muted { color: var(--muted); }
  .small { font-size: .85rem; }
  .section { padding: clamp(56px, 9vw, 110px) 0; }
  .section.alt { background: var(--soft); backdrop-filter: blur(8px); }
  .lead { font-size: 1.2rem; color: var(--muted); max-width: 60ch; }
  .eyebrow { display: inline-block; color: var(--accent); background: var(--tint); padding: .25rem .75rem; border-radius: 999px; font-size: .9rem; font-weight: 600; margin-bottom: .6rem; }
  .btn { display: inline-flex; align-items: center; gap: .4rem; background: var(--btn); box-shadow: var(--btn-shadow); color: var(--brand-ink); padding: .85rem 1.4rem; border-radius: 999px; font-weight: 600; text-decoration: none; border: 0; cursor: pointer; transition: transform .15s, box-shadow .15s; }
  .btn:hover { transform: translateY(-1px); box-shadow: var(--shadow); }
  .btn.ghost { background: transparent; color: var(--ink); box-shadow: inset 0 0 0 1.5px var(--line); }
  .btn-sm { padding: .55rem 1.1rem; }
  .grid { display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .card { background: var(--surface); backdrop-filter: blur(16px) saturate(1.3); border: 1px solid var(--glass-line); border-radius: var(--radius); padding: 28px; box-shadow: var(--shadow); }
  .card p:last-child { margin-bottom: 0; }

  .site-header { position: sticky; top: 0; z-index: 10; background: color-mix(in srgb, var(--bg) 85%, transparent); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 68px; }
  .brand img { width: 40px; height: 40px; object-fit: contain; }
  .brand { display: flex; align-items: center; gap: .6rem; font-weight: 650; letter-spacing: -.02em; font-size: 1.15rem; text-decoration: none; margin: 0; }
  nav { display: flex; align-items: center; gap: 1.6rem; }
  nav a { text-decoration: none; font-weight: 500; }
  nav a:not(.btn):hover, nav a[aria-current] { color: var(--accent); }
  .menu-toggle, .menu-btn { display: none; }
  @media (max-width: 820px) {
    .menu-btn { display: block; width: 28px; height: 20px; position: relative; cursor: pointer; }
    .menu-btn span, .menu-btn::before, .menu-btn::after { content: ''; position: absolute; left: 0; right: 0; height: 2px; background: var(--ink); }
    .menu-btn::before { top: 0; } .menu-btn span { top: 9px; } .menu-btn::after { bottom: 0; }
    nav { display: none; position: absolute; top: 68px; left: 0; right: 0; flex-direction: column; align-items: flex-start; padding: 16px; gap: 1rem; background: var(--bg); border-bottom: 1px solid var(--line); }
    .menu-toggle:checked ~ nav { display: flex; }
  }

  .site-footer { background: var(--green); color: #e9f1ea; padding: 64px 0 28px; }
  .site-footer .muted, .site-footer h4 { color: rgb(233 241 234 / .75); }
  .footer-grid a { color: #f1f6f1; }
  .site-footer h4 { color: var(--gold); }
  .footer-grid { display: grid; gap: 32px; grid-template-columns: 2fr 1fr 1fr; margin-bottom: 24px; }
  .footer-grid a { display: block; text-decoration: none; margin-bottom: .4rem; color: var(--muted); }
  .footer-grid a:hover { color: var(--gold); }
  @media (max-width: 720px) { .footer-grid { grid-template-columns: 1fr; } }

  .page-hero { padding: clamp(56px, 9vw, 100px) 0 24px; }
</style>
