---
import Base from '../layouts/Base.astro';
---
<Base title="My shifts" description="Sign in to see, move or cancel your volunteer shifts.">
  <section class="wrap account">
    <div class="card signin" id="signin">
      <span class="eyebrow">Volunteers</span>
      <h1>Your shifts</h1>
      <p class="lead">Sign in with the email you used to book. We'll send a one-time code.</p>
      <form id="email-form">
        <label>Email<input name="email" type="email" required autocomplete="email" placeholder="you@example.com" /></label>
        <button class="btn">Send my code</button>
      </form>
      <form id="code-form" hidden>
        <p class="muted small" id="sent-to"></p>
        <label>6-digit code<input name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required autocomplete="one-time-code" /></label>
        <p class="muted small" id="demo-code"></p>
        <div class="row"><button type="button" class="btn ghost" id="back">Use a different email</button><button class="btn">Sign in</button></div>
      </form>
    </div>

    <div id="dash" hidden>
      <header class="dash-head">
        <div><span class="eyebrow">Signed in</span><h1>Hi, <span id="who"></span></h1></div>
        <div class="row"><a class="btn" id="book-more">Book another shift</a><button class="btn ghost" id="signout">Sign out</button></div>
      </header>
      <ul class="shifts" id="shifts"></ul>
      <p class="empty card" id="empty" hidden>No upcoming shifts yet. <a id="book-first">Pick a Saturday →</a></p>
    </div>

    <dialog id="edit">
      <form method="dialog" id="edit-form">
        <h2>Change this shift</h2>
        <label>Kitchen<select name="kitchen"></select></label>
        <label>Saturday<select name="date"></select></label>
        <label>Role<select name="role"></select></label>
        <label>People<select name="party"></select></label>
        <p class="muted small" id="edit-note"></p>
        <div class="row"><button value="cancel" class="btn ghost">Keep as is</button><button value="save" class="btn" id="save">Save changes</button></div>
      </form>
    </dialog>
  </section>
</Base>

<script>
  import { KITCHENS, ROLES, upcomingSaturdays, spotsLeft, signupsFor, reschedule, cancel, type Kitchen, type RoleId, type Signup } from '../lib/store';
  const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
  const $ = (id: string) => document.getElementById(id)!;
  const fmt = (d: string) => new Date(d + 'T12:00').toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' });
  const KEY = 'fmow.session.v1';
  // Temporary sign-in: a code shown on screen stands in for the emailed one until Firebase Auth is connected.
  let pending = { email: '', code: '' };
  const session = () => { try { return localStorage.getItem(KEY); } catch { return null; } };
  for (const a of [$('book-more'), $('book-first')] as HTMLAnchorElement[]) a.href = `${BASE}#volunteer`;

  $('email-form').addEventListener('submit', (e) => {
    e.preventDefault();
    pending = { email: String(new FormData(e.target as HTMLFormElement).get('email')).trim().toLowerCase(), code: String(Math.floor(100000 + Math.random() * 900000)) };
    $('sent-to').textContent = `We sent a code to ${pending.email}.`;
    $('demo-code').textContent = `Preview mode: your code is ${pending.code}. Real emails start once the site is connected.`;
    ($('email-form') as HTMLFormElement).hidden = true; ($('code-form') as HTMLFormElement).hidden = false;
  });
  $('back').addEventListener('click', () => { ($('email-form') as HTMLFormElement).hidden = false; ($('code-form') as HTMLFormElement).hidden = true; });
  $('code-form').addEventListener('submit', (e) => {
    e.preventDefault();
    const code = String(new FormData(e.target as HTMLFormElement).get('code'));
    if (code !== pending.code) { $('demo-code').textContent = 'That code does not match. Try again.'; return; }
    try { localStorage.setItem(KEY, pending.email); } catch {}
    show();
  });
  $('signout').addEventListener('click', () => { try { localStorage.removeItem(KEY); } catch {} show(); });

  function show() {
    const email = session();
    $('signin').hidden = !!email; $('dash').hidden = !email;
    if (!email) return;
    $('who').textContent = email.split('@')[0];
    const list = signupsFor(email);
    $('empty').hidden = list.length > 0;
    $('shifts').innerHTML = list.map((s) => {
      const r = ROLES.find((x) => x.id === s.role)!;
      return `<li class="card shift ${s.status}">
        <div class="when"><b>${fmt(s.date)}</b><span>${r.time}</span></div>
        <div class="what"><b>${r.name}</b><span>${KITCHENS[s.kitchen]} kitchen · ${s.party} ${s.party > 1 ? 'people' : 'person'}</span></div>
        <em class="tag">${s.status === 'booked' ? 'Confirmed' : 'Waitlist'}</em>
        <div class="acts"><button class="btn ghost" data-edit="${s.id}">Change</button><button class="link danger" data-cancel="${s.id}">Cancel</button></div>
      </li>`;
    }).join('');
  }

  const dlg = $('edit') as HTMLDialogElement, ef = $('edit-form') as HTMLFormElement;
  let editing: Signup | null = null;
  const sel = (n: string) => ef.elements.namedItem(n) as HTMLSelectElement;
  sel('kitchen').innerHTML = (Object.keys(KITCHENS) as Kitchen[]).map((k) => `<option value="${k}">${KITCHENS[k]}</option>`).join('');
  sel('date').innerHTML = upcomingSaturdays().map((d) => `<option value="${d}">${fmt(d)}</option>`).join('');
  sel('role').innerHTML = ROLES.map((r) => `<option value="${r.id}">${r.name} · ${r.time}</option>`).join('');
  sel('party').innerHTML = [1, 2, 3, 4, 5, 6].map((n) => `<option>${n}</option>`).join('');
  const note = () => {
    if (!editing) return;
    const k = sel('kitchen').value as Kitchen, d = sel('date').value, r = sel('role').value as RoleId, p = Number(sel('party').value);
    const same = k === editing.kitchen && d === editing.date && r === editing.role;
    const free = spotsLeft(k, d, r) + (same && editing.status === 'booked' ? editing.party : 0);
    $('edit-note').textContent = free >= p ? `${free} spot${free === 1 ? '' : 's'} open. You're good.` : `Only ${free} open, so this would put you on the waitlist.`;
  };
  ef.addEventListener('change', note);
  $('shifts').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button'); if (!b) return;
    const email = session()!;
    if (b.dataset.cancel) { if (confirm('Cancel this shift? Your spot goes to the next person on the waitlist.')) { cancel(b.dataset.cancel); show(); } return; }
    if (b.dataset.edit) {
      editing = signupsFor(email).find((s) => s.id === b.dataset.edit) ?? null; if (!editing) return;
      sel('kitchen').value = editing.kitchen; sel('date').value = editing.date; sel('role').value = editing.role; sel('party').value = String(editing.party);
      note(); dlg.showModal();
    }
  });
  dlg.addEventListener('close', () => {
    if (dlg.returnValue === 'save' && editing) reschedule(editing.id, { kitchen: sel('kitchen').value as Kitchen, date: sel('date').value, role: sel('role').value as RoleId, party: Number(sel('party').value) });
    editing = null; show();
  });
  show();
</script>

<style is:global>
  .account { padding: clamp(40px, 8vw, 90px) 16px; max-width: 760px; }
  .account .signin { max-width: 440px; margin: 0 auto; padding: 32px; }
  .account .signin h1 { margin: .3em 0 .2em; }
  .account form { display: grid; gap: 14px; margin-top: 18px; }
  .account [hidden] { display: none !important; }
  .account label { display: grid; gap: 6px; font-weight: 500; font-size: .92rem; }
  .account input, .account select { font: inherit; padding: .75rem .9rem; border: 1.5px solid var(--line); border-radius: 12px; background: #fff; }
  .account input:focus, .account select:focus { outline: none; border-color: var(--green-2); box-shadow: 0 0 0 3px rgb(47 107 74 / .15); }
  .account .btn { border: 0; cursor: pointer; font: inherit; font-weight: 600; justify-content: center; }
  .account .row { display: flex; gap: 10px; flex-wrap: wrap; justify-content: flex-end; }
  .account .dash-head { display: flex; justify-content: space-between; align-items: end; gap: 16px; flex-wrap: wrap; margin-bottom: 22px; }
  .account .dash-head h1 { margin: .2em 0 0; }
  .account .shifts { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; }
  .account .shift { display: grid; grid-template-columns: 1.1fr 1.3fr auto; grid-template-rows: auto auto; gap: 6px 18px; padding: 18px 20px; align-items: center; }
  .account .shift .when, .account .shift .what { display: grid; gap: 2px; }
  .account .shift span { color: var(--muted); font-size: .9rem; }
  .account .shift .tag { font-style: normal; font-size: .8rem; font-weight: 600; padding: .25rem .7rem; border-radius: 99px; background: rgb(47 107 74 / .12); color: var(--green-2); justify-self: end; }
  .account .shift.waitlist .tag { background: rgb(226 194 122 / .3); color: #8a6a1f; }
  .account .shift .acts { grid-column: 1 / -1; display: flex; gap: 14px; align-items: center; justify-content: flex-end; }
  .account .link { background: none; border: 0; font: inherit; font-weight: 600; cursor: pointer; padding: 0; }
  .account .danger { color: #b4433a; }
  .account .empty { padding: 22px; text-align: center; }
  .account .empty a { color: var(--green-2); font-weight: 600; }
  dialog { border: 0; border-radius: 22px; padding: 26px; width: min(460px, calc(100% - 32px)); box-shadow: 0 30px 80px rgb(0 0 0 / .25); }
  dialog::backdrop { background: rgb(20 30 24 / .35); backdrop-filter: blur(3px); }
  dialog h2 { margin: 0; }
  @media (max-width: 620px) { .account .shift { grid-template-columns: 1fr auto; } .account .shift .what { grid-column: 1 / -1; grid-row: 2; } .account .shift .acts { grid-row: 3; } }
</style>
