---
// /story: a painted, chaptered landing-page variant. The home page and /paint are untouched.
const B = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const STRIPE_LINK = 'https://donate.stripe.com/REPLACE_ME';
const amounts = [10, 25, 50, 100, 250];
const scenes = [
  { id: 'dawn', n: '1', title: '5:40 a.m.', cap: 'Before the city wakes, a kitchen light comes on.', alt: 'A painting of power lines against a deep navy sky and one warm lit kitchen window on a dark building.' },
  { id: 'kitchen', n: '2', title: 'The kitchen', cap: 'By seven, a whole room is cooking.', alt: 'A painting of a lit kitchen seen through a window, small dark figures at a counter and steam rising from pots.' },
  { id: 'road', n: '3', title: 'The road', cap: 'Every bag is packed by hand, then rides out across the city.', alt: 'A painting of a morning sky with dabbed clouds and a white van crossing an overpass.' },
  { id: 'overpass', n: '4', title: 'Under the overpass', cap: 'Someone is already waiting. Someone else is on the way.', alt: 'A painting of a person sitting alone by a chain-link fence in long grass while another figure walks toward them carrying a mustard paper bag.' },
  { id: 'hands', n: '5', title: 'Hand to hand', cap: 'Still warm. That is the whole point.', alt: 'A close painting of two hands meeting around a mustard paper meal bag.' },
  { id: 'evening', n: '6', title: 'Evening', cap: 'By night, there are more people at the table than there were at dawn.', alt: 'A painting of dusk with people together around a long table under string lights and a moon.' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Free Meals on Wheels: one Saturday</title>
  <meta name="description" content="Free Meals on Wheels cooks and delivers free, fresh meals to neighbors in need across the Bay Area. One Saturday, in six paintings." />
  <link rel="icon" href={`${B}logo.png`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Figtree:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="top">
    <a href={B} class="brand"><span>Free Meals on Wheels</span></a>
    <nav aria-label="Main">
      <a href="#story">Our story</a>
      <a href="#volunteer">Volunteer</a>
      <a href="#meal">Get a meal</a>
      <a href="#contact">Contact</a>
      <a href="#donate" class="don">Donate</a>
    </nav>
  </header>

  <main>
    <section class="intro" id="story">
      <h1>One Saturday, in six paintings.</h1>
      <p>Free Meals on Wheels cooks and delivers fresh meals to neighbors every Saturday, across San Jose and San Ramon.</p>
      <p class="quick"><a href={`${B}volunteer`}>Volunteer</a><a href="#donate">Donate</a><a href="#meal">Get a meal</a></p>
    </section>

    {scenes.map((s) => (
      <section class="scene" id={`s-${s.id}`}>
        <figure class="frame"><canvas data-scene={s.id} role="img" aria-label={s.alt}></canvas></figure>
        <div class="cap"><span class="num">{s.n} / 6</span><h2>{s.title}</h2><p>{s.cap}</p></div>
        {s.id === 'evening' && (
          <div class="finale">
            <h2>Dignity starts with <em>a full belly.</em></h2>
            <p>Fresh meals, cooked the same morning and delivered by hand, still warm. Made by 400+ neighbors for neighbors.</p>
            <div class="btns"><a class="btn solid" href={`${B}volunteer`}>Volunteer</a><a class="btn warm" href="#donate">Donate</a><a class="btn" href="#meal">Get a meal</a></div>
          </div>
        )}
      </section>
    ))}

    <section class="sec about" id="about">
      <div class="text">
        <h2>Neighbors feeding neighbors.</h2>
        <p class="big">Every week, 400+ volunteers cook and pack 300+ meals, and every penny of every donation goes to food.</p>
        <p>Japjot Sethi and Devinder Kumar believed no neighbor should go to bed hungry, so they started cooking. Today Free Meals on Wheels is a 501(c)(3) nonprofit that cooks, packs and delivers fresh meals every Saturday from San Jose and San Ramon.</p>
        <blockquote>“A fresh, hot, and nutritious meal is not just satiating, but more importantly, enabling and liberating.”</blockquote>
        <dl class="values">
          <div><dt>Dignity first</dt><dd>We believe in the innate dignity of the human spirit, regardless of circumstances.</dd></div>
          <div><dt>Fresh, not frozen</dt><dd>Meals are cooked the same morning they are delivered.</dd></div>
          <div><dt>Every dollar counts</dt><dd>Every penny of every donation goes directly to meals.</dd></div>
        </dl>
        <a class="textlink" href={`${B}about`}>Read the full story</a>
      </div>
    </section>

    <section class="sec" id="volunteer">
      <figure class="vig"><canvas data-scene="bags" data-small aria-label="A painting of mustard paper meal bags lined up on a counter"></canvas></figure>
      <div class="text">
        <h2>Pick a Saturday shift. You're in.</h2>
        <p class="big">Choose a kitchen, a date and a role. Your spot is confirmed instantly, no waiting on an email back.</p>
        <ol class="day"><li><b>7:00</b><span>We cook.</span></li><li><b>9:30</b><span>We pack.</span></li><li><b>11:00</b><span>Meals are on their way.</span></li></ol>
        <p>First time? Wear closed-toe shoes, tie back long hair and arrive 10 minutes early. We'll show you everything. Coming as a group of 7 or more, or a corporate day? <a href="mailto:info@freemealsonwheels.com?subject=Group%20volunteering">Email us</a>.</p>
        <div class="btns"><a class="btn solid" href={`${B}volunteer`}>Volunteer</a><a class="textlink" href={`${B}my-shifts`}>Already signed up? Log in</a></div>
      </div>
    </section>

    <section class="sec" id="meal">
      <figure class="vig"><canvas data-scene="bowl" data-small aria-label="A painting of a warm bowl of soup with steam rising"></canvas></figure>
      <div class="text">
        <h2>Sit down. This one's for you.</h2>
        <p class="big">A fresh, hot meal, free for anyone who needs one. No forms, no questions, no one asking why. Just good food and good company.</p>
        <ul class="facts">
          <li><b>Saturdays, 11 AM – 1 PM</b><span>Meals delivered across San Jose and San Ramon</span></li>
          <li><b>Can't get out?</b><span>Email us with your name, address and how many people are in your household, and we'll add you to a delivery route.</span></li>
          <li><b>Need more help?</b><span>Dial 211 for food, housing and health services near you.</span></li>
        </ul>
        <div class="btns"><a class="btn" href="mailto:info@freemealsonwheels.com?subject=Meal%20request">Get a meal</a><a class="textlink" href={`${B}resources`}>More resources</a></div>
      </div>
    </section>

    <section class="sec" id="donate">
      <figure class="vig"><canvas data-scene="night" data-small aria-label="A painting of a mustard meal bag under a night sky and a full moon"></canvas></figure>
      <div class="text">
        <h2>Somebody eats tonight because of you.</h2>
        <p class="big">$10 covers a fresh, hot meal, and 100% goes to food.</p>
        <div class="amounts" role="group" aria-label="Donation amount">
          {amounts.map((a, i) => <button type="button" data-amt={a} aria-pressed={i === 1}>${a}</button>)}
        </div>
        <p class="meals" id="meals" aria-live="polite">That's <b>2</b> warm meals, made on Saturday.</p>
        <p>When it gets cold, we pair a hot meal with a warm blanket. At Thanksgiving, everyone gets a seat at the table.</p>
        <div class="btns"><a class="btn warm" href={STRIPE_LINK}>Donate securely</a></div>
        <p class="fine">Payments by Stripe. One-time or monthly. Tax-deductible, we're a 501(c)(3).</p>
      </div>
    </section>

    <section class="sec" id="contact">
      <figure class="vig"><canvas data-scene="window" data-small aria-label="A painting of one lit window on a dark night wall"></canvas></figure>
      <div class="text">
        <h2>We'd love to hear from you.</h2>
        <ul class="facts">
          <li><b>Email</b><span><a href="mailto:info@freemealsonwheels.com">info@freemealsonwheels.com</a></span></li>
          <li><b>Instagram</b><span><a href="https://www.instagram.com/freemealsonwheels/">@freemealsonwheels</a></span></li>
          <li><b>Facebook</b><span><a href="https://www.facebook.com/Freemeals20/">Free Meals on Wheels</a></span></li>
        </ul>
        <a class="textlink" href={`${B}contact`}>Corporate team days and partnerships</a>
      </div>
    </section>
  </main>

  <footer class="foot">
    <p>Free Meals on Wheels · a 501(c)(3) nonprofit · <a href="mailto:info@freemealsonwheels.com">info@freemealsonwheels.com</a></p>
    <p><a href={B}>Visit the 3D kitchen</a> · <a href={`${B}paint`}>The other painted version</a></p>
  </footer>

  <script>
    import { startStory } from '../lib/story/index';
    const q = new URLSearchParams(location.search);
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches || q.get('reduced') === '1';
    startStory({ reduced, freeze: q.has('freeze'), seek: q.has('t') ? Number(q.get('t')) : undefined });
    const meals = document.getElementById('meals')!;
    document.querySelectorAll<HTMLButtonElement>('[data-amt]').forEach((b) => b.addEventListener('click', () => {
      document.querySelectorAll('[data-amt]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      const m = Math.floor(Number(b.dataset.amt) / 10) || 1;
      meals.innerHTML = `That's <b>${m}</b> warm meal${m > 1 ? 's' : ''}, made on Saturday.`;
    }));
  </script>
</body>
</html>

<style is:global>
  :root { --bg: #fcfbf8; --ink: #1d2024; --muted: #666a6e; --rule: #e4e1d8; --warm: #c9822a; --serif: 'Instrument Serif', Georgia, serif; --sans: Figtree, system-ui, sans-serif; }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-padding-top: 70px; }
  body { margin: 0; background: var(--bg); color: var(--ink); font: 400 16px/1.6 var(--sans); -webkit-font-smoothing: antialiased; overflow-x: hidden; }
  a { color: inherit; }
  :focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }

  .top { position: sticky; top: 0; z-index: 10; display: flex; justify-content: space-between; align-items: center; gap: 16px; height: 56px; padding: 0 clamp(16px, 4vw, 56px); background: rgb(252 251 248 / .94); backdrop-filter: blur(8px); border-bottom: 1px solid var(--rule); }
  .brand { text-decoration: none; font: 500 15px/1 var(--sans); letter-spacing: -.005em; white-space: nowrap; }
  .top nav { display: flex; align-items: center; gap: clamp(14px, 2.2vw, 30px); font-size: 14px; }
  .top nav a { text-decoration: none; color: var(--muted); } .top nav a:hover { color: var(--ink); }
  .top nav a.don { color: var(--ink); border: 1px solid var(--ink); padding: 6px 14px; }
  .top nav a.don:hover { background: var(--ink); color: #fff; }

  .intro { width: min(1000px, 100% - 40px); margin: 0 auto; padding: clamp(28px, 5vw, 56px) 0 clamp(18px, 3vw, 32px); }
  .intro h1 { margin: 0 0 .4rem; font: 400 clamp(2rem, 4.2vw, 3.1rem)/1.05 var(--serif); letter-spacing: -.01em; }
  .intro p { margin: 0; color: var(--muted); max-width: 40rem; }
  .intro .quick { margin-top: .7rem; display: flex; gap: 20px; font-size: 14px; }
  .intro .quick a { color: var(--ink); text-underline-offset: 4px; }

  .scene { width: min(1000px, 100% - 28px); margin: 0 auto; padding: clamp(28px, 6vw, 72px) 0 0; }
  .frame { margin: 0; width: min(100%, max(520px, calc((100svh - 150px) * 1.83))); margin-inline: auto; }
  .frame canvas { display: block; width: 100%; box-shadow: 0 0 0 1px var(--rule), 0 14px 34px -22px rgb(30 25 15 / .35); }
  .cap { display: grid; grid-template-columns: 4.5rem 1fr; align-items: baseline; gap: 4px 12px; margin: 16px auto 0; width: min(100%, max(520px, calc((100svh - 150px) * 1.83))); padding: 0 2px; }
  .cap .num { grid-row: 1 / span 2; font-size: 13px; color: var(--muted); }
  .cap h2 { margin: 0; font: 400 1.5rem/1.15 var(--serif); }
  .cap p { margin: 0; color: var(--muted); font: 400 1.18rem/1.35 var(--serif); font-style: italic; }
  .finale { text-align: center; padding: clamp(48px, 8vw, 100px) 0 clamp(24px, 4vw, 48px); }
  .finale h2 { margin: 0 auto .8rem; max-width: 12em; font: 400 clamp(2.6rem, 6vw, 4.8rem)/.98 var(--serif); letter-spacing: -.015em; text-wrap: balance; }
  .finale h2 em { font-style: italic; }
  .finale p { margin: 0 auto 1.6rem; max-width: 30rem; color: var(--muted); }
  .btns { display: flex; flex-wrap: wrap; gap: 12px 16px; align-items: center; }
  .finale .btns { justify-content: center; }
  .btn { display: inline-block; text-decoration: none; font: 500 15px/1 var(--sans); padding: 14px 24px; border: 1px solid var(--ink); background: transparent; color: var(--ink); transition: background .2s, color .2s; }
  .btn:hover { background: var(--ink); color: #fff; }
  .btn.solid { background: var(--ink); color: #fff; } .btn.solid:hover { background: #3a3f46; }
  .btn.warm { background: var(--warm); border-color: var(--warm); color: #fff; } .btn.warm:hover { background: #a96a1d; border-color: #a96a1d; }

  .sec { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(24px, 5vw, 72px); align-items: center; width: min(1000px, 100% - 40px); margin: 0 auto; padding: clamp(48px, 8vw, 96px) 0; border-top: 1px solid var(--rule); }
  .sec.about { margin-top: clamp(40px, 8vw, 100px); grid-template-columns: minmax(0, 36rem); }
  .vig { margin: 0; } .vig canvas { display: block; width: 100%; box-shadow: 0 0 0 1px var(--rule), 0 12px 28px -20px rgb(30 25 15 / .35); }
  .text { max-width: 34rem; }
  .sec h2 { margin: 0 0 .9rem; font: 400 clamp(2rem, 3.6vw, 2.8rem)/1.05 var(--serif); letter-spacing: -.01em; text-wrap: balance; }
  .big { font: 400 1.3rem/1.4 var(--serif); margin: 0 0 1.1rem; }
  .text p { margin: 0 0 1rem; } .text p a, .facts a { text-underline-offset: 3px; }
  .textlink { font-size: 15px; text-underline-offset: 4px; }
  blockquote { margin: 1.4rem 0; padding-left: 1.1rem; border-left: 1px solid var(--ink); font: italic 400 1.35rem/1.35 var(--serif); }
  .values { margin: 1.6rem 0; display: grid; gap: .9rem; } .values dt { font-weight: 600; } .values dd { margin: 0; color: var(--muted); }
  .day { list-style: none; margin: 1.2rem 0; padding: 0; display: grid; border-top: 1px solid var(--rule); }
  .day li { display: flex; gap: 14px; align-items: baseline; padding: .5rem 0; border-bottom: 1px solid var(--rule); }
  .day b { font: 400 1.5rem/1 var(--serif); min-width: 3.4rem; }
  .facts { list-style: none; margin: 1.4rem 0; padding: 0; display: grid; gap: 1rem; } .facts b { display: block; font-weight: 600; } .facts span { color: var(--muted); }
  .amounts { display: flex; flex-wrap: wrap; gap: 8px; margin: 1.2rem 0 .8rem; }
  .amounts button { font: 500 15px var(--sans); color: var(--ink); background: none; border: 1px solid var(--rule); padding: 10px 18px; cursor: pointer; }
  .amounts button[aria-pressed='true'] { border-color: var(--ink); background: var(--ink); color: #fff; }
  .meals { font: 400 1.4rem/1.3 var(--serif); } .meals b { font-weight: 400; color: var(--warm); }
  .fine { font-size: 13px; color: var(--muted); margin-top: 1rem !important; }
  .foot { display: grid; gap: 4px; justify-items: center; padding: 40px 20px 56px; border-top: 1px solid var(--rule); color: var(--muted); font-size: 13px; text-align: center; } .foot p { margin: 0; }

  @media (max-width: 760px) {
    .brand { font-size: 14px; } .top nav a:not(.don) { display: none; }
    .sec, .sec.about { grid-template-columns: 1fr; }
    .cap { grid-template-columns: 3.4rem 1fr; width: 100%; } .frame { width: 100%; }
  }
</style>
