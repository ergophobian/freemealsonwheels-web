---
import Base from '../layouts/Base.astro';
const STRIPE_LINK = 'https://donate.stripe.com/REPLACE_ME';
---
<Base title="Home" immersive>
  <section class="world" id="world" data-stripe={STRIPE_LINK}>
    <canvas class="world-canvas" id="scene" aria-hidden="true"></canvas>
    <div class="loader" id="loader" aria-live="polite">
      <img src={`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}img/logo-heart.png`} alt="" width="120" height="106" />
      <p>Setting up the kitchen…</p>
      <i class="bar"><b id="load-bar"></b></i>
    </div>
    <header class="hud">
      <a class="hud-brand" href={import.meta.env.BASE_URL}><img src={`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}img/logo-heart.png`} alt="" width="38" height="34" /><span>Free Meals on Wheels</span></a>
      <nav class="hud-nav">
        <button data-open="about">Our story</button>
        <button data-open="volunteer">Volunteer</button>
        <button data-open="resources">Get a meal</button>
        <button data-open="contact">Contact</button>
        <button data-shifts>My shifts</button>
        <button class="hud-give" data-open="donate">Donate</button>
      </nav>
    </header>
    <div class="intro">
      <span class="eyebrow">San Jose and San Ramon · every Saturday</span>
      <h1>Dignity starts with <em>a full belly.</em></h1>
      <p class="hint-desktop">Welcome to our kitchen. Drag to look around, click anything to step in.</p>
      <p class="hint-mobile">Swipe around the kitchen and tap what you need.</p>
    </div>
    <div class="labels" id="labels">
      <button data-station="volunteer"><i></i>Volunteer</button>
      <button data-station="donate"><i></i>Donate</button>
      <button data-station="about"><i></i>Our story</button>
      <button data-station="resources"><i></i>Get a meal</button>
      <button data-station="contact"><i></i>Contact</button>
    </div>
    <div class="swiper" id="swiper">
      <button id="prev" aria-label="Previous">‹</button>
      <span class="count"><b id="count">01</b> / 05 · <i id="cname">Volunteer</i></span><span id="dots"></span>
      <button id="next" aria-label="Next">›</button>
    </div>
    <div class="quick" id="quick">
      <button class="btn go" id="go" hidden>Open</button>
      <button class="btn" data-open="volunteer">Volunteer</button>
      <button class="btn ghost" data-open="donate">Donate</button>
    </div>
    <aside class="pop" id="pop" aria-hidden="true" role="dialog" aria-labelledby="pop-title">
      <button class="pop-close" id="pop-close" aria-label="Back to the street">×</button>
      <div id="pop-body"></div>
    </aside>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true"><filter id="chalky"><feTurbulence type="fractalNoise" baseFrequency="1.2" numOctaves="2" result="n"/><feDisplacementMap in="SourceGraphic" in2="n" scale="2.5"/></filter></svg>
    <section class="story" id="story" aria-hidden="true" aria-label="Our story">
      <div class="chalkboard">
        <button class="sheet-close" data-close aria-label="Back to the street">×</button>
        <div class="chapters"></div>
        <nav class="story-nav">
          <button class="s-prev" aria-label="Previous">‹</button>
          <span class="s-dots"></span>
          <button class="s-next" aria-label="Next">›</button>
        </nav>
      </div>
    </section>
    <section class="board" id="board" aria-hidden="true" aria-label="Community board">
      <div class="cork">
        <button class="sheet-close" data-close aria-label="Back to the street">×</button>
        <div class="pinned">
          <div class="paper title"><i class="pin"></i><h2>Community board</h2><p>Questions, ideas, a team that wants to help, or just a hello. It all goes here.</p></div>
          <a class="paper card" href="mailto:info@freemealsonwheels.com"><i class="pin"></i><small>Write to us</small><b>info@freemealsonwheels.com</b><span>A real person reads every note.</span></a>
          <a class="polaroid" href="https://www.instagram.com/freemealsonwheels/"><i class="tape"></i><img src={`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}img/smile.webp`} alt="" loading="lazy" /><span>@freemealsonwheels</span></a>
          <a class="paper flyer green" href="mailto:info@freemealsonwheels.com?subject=Corporate%20team%20day"><i class="pin"></i><b>Bring your team</b><span>Cook and pack together on a Saturday. Great for companies, schools and clubs.</span></a>
          <a class="paper flyer peach" href="mailto:info@freemealsonwheels.com?subject=Blanket%20drive"><i class="pin"></i><b>Host a blanket drive</b><span>Every winter we pair a hot meal with a warm blanket.</span></a>
          <a class="paper note" href="https://www.facebook.com/Freemeals20/"><i class="pin"></i><b>Find us on Facebook</b><span>Free Meals on Wheels</span></a>
          <button class="paper note yellow" data-goto="resources"><i class="pin"></i><b>Need a meal?</b><span>There's a seat for you. Tap here.</span></button>
          <form class="paper letter note-form"><i class="pin"></i><b>Leave a note for the volunteers</b><textarea name="note" rows="2" placeholder="They read these on Saturday morning."></textarea><button class="btn">Pin it</button></form>
        </div>
        <p class="credits">3D world: people built with MakeHuman, animation by Quaternius, props and textures from Poly Haven. Clothing by punkduck, Mindfront and Elvaerwyn (CC BY), the rest CC0.</p>
      </div>
    </section>
  </section>
</Base>

<script>
  import { mountWorld, type StationId } from '../lib/kitchen-scene';
  const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
  import { KITCHENS, ROLES, upcomingSaturdays, spotsLeft, book, signupsFor, reschedule, cancel, type Kitchen, type RoleId } from '../lib/store';

  const ORDER: StationId[] = ['volunteer', 'donate', 'about', 'resources', 'contact'];
  const root = document.getElementById('world')!, pop = document.getElementById('pop')!, body = document.getElementById('pop-body')!;
  const STRIPE = root.dataset.stripe!;
  const labels = Object.fromEntries([...document.querySelectorAll<HTMLElement>('#labels button')].map((b) => [b.dataset.station, b])) as Record<StationId, HTMLElement>;
  const mobile = () => innerWidth < 760;
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
  const fmt = (d: string, o: Intl.DateTimeFormatOptions) => new Date(d + 'T12:00').toLocaleDateString('en-US', o);
  let idx = -1, openTimer = 0;

  const loader = document.getElementById('loader')!, loadBar = document.getElementById('load-bar')!;
  const reveal = () => { loader.classList.add('gone'); root.classList.add('ready'); };
  setTimeout(reveal, 7000); // never keep people waiting on a slow connection
  const api = mountWorld(document.getElementById('scene') as HTMLCanvasElement, labels, (id) => open(id), (id) => { const sh = sheets[id]; if (sh && location.hash === '#' + id) showSheet(sh); },
    (p, done) => { loadBar.style.width = `${Math.round(15 + p * 85)}%`; if (done) reveal(); });
  if (!api) reveal();
  if (!api) root.classList.add('no-gl');

  // Volunteer card: kitchen, Saturday, role, then a few fields. Confirmed on the spot.
  const vol = { kitchen: 'san_jose' as Kitchen, date: upcomingSaturdays()[0], role: null as RoleId | null, step: 'pick' as 'pick' | 'form' | 'done' };
  function volunteerCard() {
    if (vol.step === 'pick') {
      body.innerHTML = `
        <p class="kicker">This is the kitchen. This could be you.</p><h2 id="pop-title">Pick a Saturday shift</h2>
        <div class="seg kseg" data-at="${vol.kitchen}"><i class="pill"></i>${(Object.keys(KITCHENS) as Kitchen[]).map((k) => `<button data-k="${k}" aria-pressed="${k === vol.kitchen}">${KITCHENS[k]}</button>`).join('')}</div>
        <div class="dates">${upcomingSaturdays().map((d) => {
          const open = ROLES.reduce((n, r) => n + spotsLeft(vol.kitchen, d, r.id), 0);
          return `<button data-d="${d}" aria-pressed="${d === vol.date}"><small>${fmt(d, { month: 'short' })}</small><b>${fmt(d, { day: 'numeric' })}</b><em>${open ? open + ' open' : 'Full'}</em></button>`;
        }).join('')}</div>
        <div class="roles">${ROLES.map((r) => {
          const left = spotsLeft(vol.kitchen, vol.date, r.id);
          return `<button data-r="${r.id}"><span><b>${r.name}</b><small>${r.time}</small></span><em class="${left ? (left <= 2 ? 'low' : '') : 'full'}">${left ? left + ' left' : 'Waitlist'}</em></button>`;
        }).join('')}</div>`;
    } else if (vol.step === 'form') {
      const r = ROLES.find((x) => x.id === vol.role)!;
      body.innerHTML = `
        <button class="back" data-back>‹ Change shift</button>
        <h2 id="pop-title">${r.name}</h2>
        <p class="muted">${fmt(vol.date, { weekday: 'long', month: 'long', day: 'numeric' })} · ${r.time} · ${KITCHENS[vol.kitchen]}</p>
        <form id="vform">
          <label>Your name<input name="name" required autocomplete="name" /></label>
          <label>Email<input name="email" type="email" required autocomplete="email" /></label>
          <label>Phone (for day-of updates)<input name="phone" type="tel" autocomplete="tel" /></label>
          <div class="row">
            <div class="party"><span>People coming</span><div class="stepper"><button type="button" data-p="-1" aria-label="Fewer">−</button><output name="party">1</output><button type="button" data-p="1" aria-label="More">+</button></div></div>
          </div>
          <div class="guests" id="guests"></div>
          <label class="first"><input type="checkbox" name="first" /><span class="first-box"><b>It's my first time</b><small>We'll pair you with a lead and save you an apron.</small></span><i class="tick-mark">✓</i></label>
          <button class="btn wide">Confirm my spot</button>
        </form>`;
    }
  }
  body.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button'); if (!b || !body.contains(b)) return;
    if (b.dataset.k) {
      if (vol.kitchen === b.dataset.k) return;
      vol.kitchen = b.dataset.k as Kitchen;
      // Slide the pill and recolor first, then swap the dates and roles in.
      const seg = body.querySelector<HTMLElement>('.kseg')!; seg.dataset.at = vol.kitchen;
      seg.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      pop.dataset.kitchen = vol.kitchen;
      const parts = body.querySelectorAll<HTMLElement>('.dates, .roles');
      parts.forEach((el) => el.classList.add('swap'));
      setTimeout(() => { volunteerCard(); body.querySelectorAll<HTMLElement>('.dates, .roles').forEach((el) => { el.classList.add('swap-in'); requestAnimationFrame(() => requestAnimationFrame(() => el.classList.remove('swap-in'))); }); }, 220);
    }
    else if (b.dataset.d) { vol.date = b.dataset.d; volunteerCard(); }
    else if (b.dataset.r) { vol.role = b.dataset.r as RoleId; b.classList.add('picked'); body.querySelectorAll('.roles button').forEach((x) => x !== b && x.classList.add('fade')); setTimeout(() => { vol.step = 'form'; volunteerCard(); body.firstElementChild?.parentElement?.classList.add('slide-in'); setTimeout(() => body.classList.remove('slide-in'), 450); }, 280); }
    else if ('shiftsIn' in b.dataset) { try { localStorage.setItem('fmow.session.v1', String(body.querySelector('.done')?.getAttribute('data-email') || '')); } catch {} openShifts(); }
    else if ('back' in b.dataset || 'again' in b.dataset) { vol.step = 'pick'; volunteerCard(); }
    else if (b.dataset.p) {
      // Party stepper: one name field per extra person.
      const out = body.querySelector<HTMLOutputElement>('output[name="party"]')!, n = Math.max(1, Math.min(6, Number(out.value) + Number(b.dataset.p)));
      out.value = String(n);
      const g = body.querySelector('#guests')!, have = g.children.length;
      for (let i = have; i < n - 1; i++) { const l = document.createElement('label'); l.className = 'guest'; l.innerHTML = `Guest ${i + 2}<input name="guest" placeholder="Their name" autocomplete="off" />`; g.append(l); }
      while (g.children.length > n - 1) g.lastElementChild!.remove();
    }
    else if (b.dataset.amt) {
      body.querySelectorAll('[data-amt]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      const a = Number(b.dataset.amt), m = Math.floor(a / 10) || 1;
      api?.give(a);
      document.getElementById('meals')!.innerHTML = `That's <b>${m}</b> warm meal${m > 1 ? 's' : ''}, made with love on Saturday.`;
    }
  });
  body.addEventListener('submit', (e) => {
    e.preventDefault();
    const f = new FormData(e.target as HTMLFormElement), r = ROLES.find((x) => x.id === vol.role)!;
    const guests = f.getAll('guest').map(String).map((g) => g.trim()).filter(Boolean);
    const party = 1 + body.querySelectorAll('[name="guest"]').length;
    const s = book({ kitchen: vol.kitchen, date: vol.date, role: r.id, name: String(f.get('name')) + (guests.length ? ` + ${guests.join(', ')}` : ''), email: String(f.get('email')), phone: String(f.get('phone') || ''), party, firstTime: f.has('first') });
    vol.step = 'done';
    const [st, en] = r.time.split(' – ');
    const t = (x: string) => { const [hm, ap] = x.trim().split(' '); let [h, m] = hm.split(':').map(Number); if (ap === 'PM' && h < 12) h += 12; return vol.date.replace(/-/g, '') + 'T' + String(h).padStart(2, '0') + String(m).padStart(2, '0') + '00'; };
    const ics = `BEGIN:VCALENDAR\nVERSION:2.0\nBEGIN:VEVENT\nSUMMARY:Free Meals on Wheels · ${r.name}\nDTSTART:${t(st.includes('M') ? st : st + ' ' + en.split(' ')[1])}\nDTEND:${t(en)}\nLOCATION:${KITCHENS[vol.kitchen]} kitchen\nEND:VEVENT\nEND:VCALENDAR`;
    body.innerHTML = s.status === 'booked' ? `
      <div class="done" data-email="${esc(s.email)}"><span class="tick">✓</span><h2 id="pop-title">You're in, ${esc(s.name.split(' ')[0])}!</h2>
      <p class="muted">${r.name} · ${fmt(vol.date, { weekday: 'long', month: 'long', day: 'numeric' })} · ${r.time}. A confirmation is on its way to ${esc(s.email)}.</p>
      <a class="btn wide" download="free-meals-shift.ics" href="data:text/calendar;charset=utf-8,${encodeURIComponent(ics)}">Add to calendar</a>
      <button class="link" data-shifts-in>Manage your shifts →</button><br /><button class="link" data-again>Book another shift</button></div>` : `
      <div class="done"><span class="tick wait">…</span><h2 id="pop-title">You're on the waitlist</h2>
      <p class="muted">That shift is full. We'll email ${esc(s.email)} the moment a spot opens.</p>
      <button class="link" data-again>Pick a different shift</button></div>`;
  });

  const CARDS: Record<Exclude<StationId, 'volunteer'>, () => string> = {
    donate: () => `
      <p class="kicker">Every coin is a warm dinner</p><h2 id="pop-title">Somebody eats tonight because of you</h2>
      <p class="muted">Tap an amount and watch it land. $10 covers a fresh, hot meal, and 100% goes to food.</p>
      <div class="amounts">${[10, 25, 50, 100, 250].map((a, i) => `<button data-amt="${a}" aria-pressed="${i === 1}">$${a}</button>`).join('')}</div>
      <p class="meals" id="meals">That's <b>2</b> warm meals, made with love on Saturday.</p>
      <a class="btn wide" href="${STRIPE}">Donate securely</a>
      <p class="fine">Payments by Stripe. One-time or monthly. Tax-deductible, we're a 501(c)(3).</p>`,
    about: () => `
      <p class="kicker">Our story</p><h2 id="pop-title">Neighbors feeding neighbors</h2>
      <p class="muted">Founded by Japjot Sethi and Devinder Kumar, Free Meals on Wheels cooks, packs and delivers fresh meals every Saturday from San Jose and San Ramon.</p>
      <div class="stats"><div><b>300+</b><small>meals a week</small></div><div><b>400+</b><small>volunteers</small></div><div><b>100%</b><small>to meals</small></div></div>
      <a class="link" href="${BASE}about">Read the full story →</a>`,
    resources: () => `
      <p class="kicker">Need a meal?</p><h2 id="pop-title">Sit down. This one's for you.</h2>
      <p class="muted">A fresh, hot meal, free for anyone who needs one. No forms, no questions, no one asking why. Just good food and good company.</p>
      <ul class="list"><li><b>Saturdays, 11 AM – 1 PM</b><small>Meals delivered across San Jose and San Ramon</small></li><li><b>Can't get out?</b><small>Email us and we'll add you to a delivery route</small></li></ul>
      <a class="btn wide" href="mailto:info@freemealsonwheels.com?subject=Meal%20delivery">Request a meal</a>
      <a class="link" href="${BASE}resources">More resources →</a>`,
    contact: () => `
      <p class="kicker">Say hello</p><h2 id="pop-title">We'd love to hear from you</h2>
      <ul class="list"><li><b>Email</b><a href="mailto:info@freemealsonwheels.com">info@freemealsonwheels.com</a></li>
      <li><b>Instagram</b><a href="https://www.instagram.com/freemealsonwheels/">@freemealsonwheels</a></li>
      <li><b>Facebook</b><a href="https://www.facebook.com/Freemeals20/">Free Meals on Wheels</a></li></ul>
      <a class="link" href="${BASE}contact">Corporate team days and partnerships →</a>`,
  };

  const sheets: Partial<Record<StationId, HTMLElement>> = { about: document.getElementById('story')!, contact: document.getElementById('board')! };
  function open(id: StationId) {
    idx = ORDER.indexOf(id); syncDots(); root.classList.add('focus');
    closeSheets(); root.classList.remove('open');
    api?.focus(id);
    clearTimeout(openTimer);
    const sheet = sheets[id];
    if (sheet) {
      if (id === 'about') showChapter(0);
      if (!api) showSheet(sheet);
    } else {
      pop.dataset.kitchen = id === 'volunteer' ? vol.kitchen : '';
    if (id !== 'volunteer') body.innerHTML = CARDS[id]();
      else if (vol.step !== 'done' || !body.querySelector('.done')) { if (vol.step === 'done') vol.step = 'pick'; volunteerCard(); }
      openTimer = window.setTimeout(() => { root.classList.add('open'); pop.setAttribute('aria-hidden', 'false'); }, api ? 650 : 0);
    }
    history.replaceState(null, '', '#' + id);
  }
  // Boards: the camera flies into the real board in the world; the page fades in only once it arrives.
  function showSheet(sheet: HTMLElement) {
    root.classList.add('sheet');
    const id = (Object.entries(sheets).find(([, v]) => v === sheet)?.[0]) as StationId;
    if (api && wide()) { surfaces[id]?.classList.add('live'); return; }
    sheet.classList.add('on'); sheet.setAttribute('aria-hidden', 'false');
  }
  function closeSheets() {
    for (const el of Object.values(sheets)) { el!.classList.remove('on'); el!.setAttribute('aria-hidden', 'true'); }
    for (const el of [storySurface, corkSurface]) el?.classList.remove('live');
    root.classList.remove('sheet');
  }
  function close() {
    clearTimeout(openTimer); closeSheets(); root.classList.remove('focus');
    root.classList.remove('open'); pop.setAttribute('aria-hidden', 'true');
    // Leaving a station always returns to the home overview.
    idx = -1; syncDots(); api?.focus(null);
    history.replaceState(null, '', location.pathname);
  }

  // Chalk, generated in code: a dusty slate with eraser smudges, and a grain mask that makes lettering look drawn in chalk.
  {
    const rnd = (() => { let x = 9; return () => (x = (x * 16807) % 2147483647) / 2147483647; })();
    const board = document.createElement('canvas'); board.width = board.height = 1024; const b = board.getContext('2d')!;
    b.fillStyle = '#26382e'; b.fillRect(0, 0, 1024, 1024);
    for (let i = 0; i < 70; i++) {
      // Eraser swipes: long soft arcs of pale dust.
      const x = rnd() * 1024, y = rnd() * 1024, r = 80 + rnd() * 260, a = rnd() * Math.PI * 2;
      b.strokeStyle = `rgba(230,235,225,${.012 + rnd() * .03})`; b.lineWidth = 30 + rnd() * 90; b.lineCap = 'round';
      b.beginPath(); b.arc(x, y, r, a, a + .6 + rnd() * 1.4); b.stroke();
    }
    const id = b.getImageData(0, 0, 1024, 1024), d = id.data;
    for (let i = 0; i < d.length; i += 4) { const n = (rnd() - .5) * 14; d[i] += n; d[i + 1] += n; d[i + 2] += n; }
    b.putImageData(id, 0, 0);
    const dust = document.createElement('canvas'); dust.width = dust.height = 256; const c = dust.getContext('2d')!;
    const dd = c.createImageData(256, 256);
    for (let i = 0; i < dd.data.length; i += 4) { dd.data[i] = dd.data[i + 1] = dd.data[i + 2] = 255; dd.data[i + 3] = rnd() < .16 ? rnd() * 120 : 200 + rnd() * 55; }
    c.putImageData(dd, 0, 0);
    document.documentElement.style.setProperty('--slate', `url(${board.toDataURL('image/jpeg', .85)})`);
    document.documentElement.style.setProperty('--chalk', `url(${dust.toDataURL()})`);
    // Cork: soft mottled flecks at a coarse scale (fine dot patterns shimmer when the board is scaled in 3D).
    const cork = document.createElement('canvas'); cork.width = cork.height = 512; const k = cork.getContext('2d')!;
    k.fillStyle = '#c99c62'; k.fillRect(0, 0, 512, 512);
    for (let i = 0; i < 2600; i++) { const r = 1 + rnd() * 3.5, l = rnd() < .5; k.fillStyle = l ? `rgba(255,228,180,${.15 + rnd() * .25})` : `rgba(110,64,28,${.15 + rnd() * .3})`; k.beginPath(); k.ellipse(rnd() * 512, rnd() * 512, r, r * (.5 + rnd()), rnd() * 3, 0, Math.PI * 2); k.fill(); }
    document.documentElement.style.setProperty('--cork', `url(${cork.toDataURL('image/jpeg', .85)})`);
  }

  // Our story: a chalkboard storyboard with taped-up photos.
  const SK = {
    friends: '<path d="M30 90c0-14 8-22 16-22s16 8 16 22M46 60a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM78 90c0-14 8-22 16-22s16 8 16 22M94 60a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM62 74c4-6 12-6 16 0M70 28c-4-6-14-2-10 6l10 9 10-9c4-8-6-12-10-6z"/>',
    bowl: '<path d="M24 62h92c0 18-20 32-46 32S24 80 24 62zM50 94h40M52 50c-6-8 6-12 0-22M70 50c-6-8 6-12 0-22M88 50c-6-8 6-12 0-22"/>',
    clock: '<circle cx="70" cy="60" r="34"/><path d="M70 38v22l14 10M70 26v4M104 60h-4M70 94v-4M36 60h4"/>',
    houses: '<path d="M18 92V58l22-18 22 18v34zM78 92V58l22-18 22 18v34zM62 74c6-8 10-8 16 0M32 92V74h16v18M92 92V74h16v18"/>',
    truck: '<path d="M14 82V44h66v38zM80 56h22l14 14v12H80zM30 92a8 8 0 1 0 0-16 8 8 0 0 0 0 16zM100 92a8 8 0 1 0 0-16 8 8 0 0 0 0 16zM30 62c6-6 12 6 18 0s12 6 18 0"/>',
    blanket: '<path d="M24 34h92v52H24zM24 50h92M24 70h92M44 34v52M70 34v52M96 34v52M60 22l4 6M80 18l-2 8M100 24l-4 6"/>',
    heart: '<path d="M70 96S20 66 20 40c0-14 10-22 22-22 12 0 20 8 28 18 8-10 16-18 28-18 12 0 22 8 22 22 0 26-50 56-50 56z"/>',
  };
  const CH = [
    { t: 'It started with <em>two friends.</em>', b: 'Japjot Sethi and Devinder Kumar believed no neighbor should go to bed hungry. So they started cooking.', sk: SK.friends, img: ['team.webp'] },
    { t: 'A hot meal is <em>more than food.</em>', b: '“A fresh, hot, and nutritious meal is not just satiating, but more importantly, enabling and liberating.”', sk: SK.bowl, img: ['smile.webp'] },
    { t: 'Every Saturday, <em>the kitchen wakes up.</em>', b: 'We cook at 7. We pack at 9:30. By 11, meals are on their way.', sk: SK.clock, img: ['kitchen.webp', 'boxes.jpg'] },
    { t: 'Two kitchens. <em>One family.</em>', b: 'San Jose and San Ramon, and more than 400 volunteers who show up with open hearts.', sk: SK.houses, img: ['serving.jpg'] },
    { t: '300+ meals, <em>every single week.</em>', b: 'Delivered by hand, still warm, with a smile and a name.', sk: SK.truck, img: ['handoff.jpg'] },
    { t: 'Warmth <em>for winter.</em>', b: 'When it gets cold, we pair a hot meal with a warm blanket. At Thanksgiving, everyone gets a seat at the table.', sk: SK.blanket, img: ['blanket.webp', 'thanksgiving.webp'] },
    { t: 'And now, <em>you.</em>', b: 'Every meal starts with someone who decided to care. That can be you this Saturday.', sk: SK.heart, img: [], cta: true },
  ];
  const chapters = document.querySelector<HTMLElement>('#story .chapters')!, sdots = document.querySelector<HTMLElement>('#story .s-dots')!;
  chapters.innerHTML = CH.map((c, i) => `
    <article class="chapter" data-i="${i}">
      <div class="chalk">
        <small>${i + 1} / ${CH.length}</small>
        <h2>${c.t}</h2><p>${c.b}</p>
        ${c.cta ? '<div class="cta"><button class="btn" data-goto="volunteer">Volunteer this Saturday</button><button class="btn ghost" data-goto="donate">Give a meal</button></div>' : ''}
        <svg class="sketch" viewBox="0 0 140 110" aria-hidden="true"><g>${c.sk}</g></svg>
      </div>
      <div class="photos">${c.img.map((src, k) => `<figure style="--r:${(k ? 4 : -3) + (i % 2 ? 2 : -1)}deg"><i class="tape"></i><img src="${BASE}img/${src}" alt="" loading="lazy" /></figure>`).join('')}</div>
    </article>`).join('');
  sdots.innerHTML = CH.map(() => '<i></i>').join('');
  // Desktop: the same board, mounted onto the chalkboard and corkboard in the world.
  const wide = () => innerWidth >= 760;
  const storySurface = document.querySelector('#story .chalkboard')!.cloneNode(true) as HTMLElement;
  const corkSurface = document.querySelector('#board .cork')!.cloneNode(true) as HTMLElement;
  storySurface.classList.add('surface'); corkSurface.classList.add('surface');
  api?.surfaces({ about: storySurface, contact: corkSurface });
  const surfaces: Partial<Record<StationId, HTMLElement>> = { about: storySurface, contact: corkSurface };
  document.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('.s-prev, .s-next, [data-close], [data-goto]'); if (!b) return;
    if (b.matches('.s-prev')) showChapter(ch - 1); else if (b.matches('.s-next')) showChapter(ch + 1);
    else if (b.dataset.goto) open(b.dataset.goto as StationId); else close();
  });
  document.addEventListener('submit', (e) => {
    const f = e.target as HTMLFormElement; if (!f.matches('.note-form')) return; e.preventDefault();
    location.href = `mailto:info@freemealsonwheels.com?subject=${encodeURIComponent('A note for the volunteers')}&body=${encodeURIComponent(String(new FormData(f).get('note') || ''))}`;
  });
  let ch = 0;
  function showChapter(i: number) {
    ch = Math.max(0, Math.min(CH.length - 1, i));
    for (const scope of [document.getElementById('story')!, storySurface]) {
      scope.querySelectorAll('.chapter').forEach((el) => { const k = Number((el as HTMLElement).dataset.i); el.classList.toggle('on', k === ch); el.classList.toggle('past', k < ch); });
      scope.querySelectorAll('.s-dots').forEach((d) => [...d.children].forEach((x, k) => x.classList.toggle('on', k === ch)));
    }
  }
  addEventListener('keydown', (e) => { if (!root.classList.contains('sheet') || !location.hash.includes('about')) return; if (e.key === 'ArrowRight') showChapter(ch + 1); if (e.key === 'ArrowLeft') showChapter(ch - 1); });
  let csx = 0;
  sheets.about!.addEventListener('touchstart', (e) => { csx = e.touches[0].clientX; }, { passive: true });
  sheets.about!.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - csx; if (Math.abs(dx) > 50) showChapter(ch + (dx < 0 ? 1 : -1)); }, { passive: true });
  showChapter(0);

  for (const [id, el] of Object.entries(labels)) el.onclick = () => open(id as StationId);
  document.querySelectorAll<HTMLElement>('[data-open]').forEach((b) => (b.onclick = () => open(b.dataset.open as StationId)));
  document.getElementById('pop-close')!.onclick = close;
  addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });

  // Phones: swipe or use the arrows to walk around the kitchen.
  const dots = document.getElementById('dots')!;
  dots.innerHTML = ORDER.map(() => '<i></i>').join('');
  const NAMES: Record<StationId, string> = { volunteer: 'Volunteer', donate: 'Donate', about: 'Our story', resources: 'Get a meal', contact: 'Contact' };
  const GO: Record<StationId, string> = { volunteer: 'Pick a shift', donate: 'Give', about: 'Read our story', resources: 'Get a meal', contact: 'Say hello' };
  const go = document.getElementById('go') as HTMLButtonElement;
  go.onclick = () => { if (idx >= 0) open(ORDER[idx]); };
  function syncDots() { go.hidden = idx < 0; document.getElementById('quick')!.classList.toggle('peek', idx >= 0); if (idx >= 0) go.textContent = GO[ORDER[idx]]; [...dots.children].forEach((d, i) => d.classList.toggle('on', i === idx)); document.getElementById('count')!.textContent = idx < 0 ? '00' : String(idx + 1).padStart(2, '0'); document.getElementById('cname')!.textContent = idx < 0 ? (mobile() ? 'Swipe' : 'Explore') : NAMES[ORDER[idx]]; }
  function step(d: number) { idx = idx < 0 ? (d > 0 ? 0 : ORDER.length - 1) : (idx + d + ORDER.length) % ORDER.length; syncDots(); api?.focus(ORDER[idx], true); }
  document.getElementById('prev')!.onclick = () => step(-1);
  document.getElementById('next')!.onclick = () => step(1);
  let sx = 0;
  root.addEventListener('touchstart', (e) => { sx = e.touches[0].clientX; }, { passive: true });
  root.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - sx;
    if (Math.abs(dx) > 50 && !root.classList.contains('open') && !root.classList.contains('sheet')) step(dx < 0 ? 1 : -1);
  }, { passive: true });
  const applyMode = () => { if (!root.classList.contains('open') && !root.classList.contains('sheet')) api?.focus(mobile() && idx >= 0 ? ORDER[idx] : null, true); };
  addEventListener('resize', applyMode); applyMode(); syncDots();
  root.querySelector('canvas')!.addEventListener('pointerdown', () => setTimeout(() => root.classList.add('moved'), 400), { once: true });
  for (const el of [document.getElementById('prev')!, document.getElementById('next')!]) el.addEventListener('click', () => root.classList.add('moved'), { once: true });
  // ——— My shifts, inside the world: the camera goes into the kitchen and a sign-in card opens beside it.
  const SKEY = 'fmow.session.v1';
  const sess = () => { try { return localStorage.getItem(SKEY); } catch { return null; } };
  const sfmt = (d: string) => new Date(d + 'T12:00').toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
  const sh = { step: 'email' as 'email' | 'code' | 'list', email: '', code: '', editing: '', cancelling: [] as string[] };
  const REASONS = ['Schedule conflict', 'Feeling unwell', 'Transportation', 'Booked by mistake', 'Something else'];
  function shiftsCard() {
    if (sess()) sh.step = 'list';
    if (sh.step === 'email') {
      body.innerHTML = `<p class="kicker">Volunteers</p><h2 id="pop-title">Your shifts</h2>
        <p class="muted">Sign in with the email you booked with. We'll send a one-time code.</p>
        <form class="sform" data-s="email"><label>Email<input name="email" type="email" required autocomplete="email" placeholder="you@example.com" /></label><button class="btn wide">Send my code</button></form>`;
    } else if (sh.step === 'code') {
      body.innerHTML = `<button class="back" data-s-back>‹ Different email</button><h2 id="pop-title">Check your inbox</h2>
        <p class="muted">We sent a 6-digit code to ${esc(sh.email)}.</p>
        <form class="sform" data-s="code"><label>Code<input name="code" inputmode="numeric" maxlength="6" pattern="[0-9]{6}" required autocomplete="one-time-code" /></label><button class="btn wide">Sign in</button></form>
        <p class="fine">Preview mode: your code is <b>${sh.code}</b>. Real emails start once the site is connected.</p>`;
    } else {
      const email = sess()!, list = signupsFor(email);
      const row = (x: ReturnType<typeof signupsFor>[number]) => {
        const r = ROLES.find((y) => y.id === x.role)!;
        if (sh.editing === x.id) return `<li class="srow editing"><form class="sform" data-s="edit" data-id="${x.id}">
          <label>Kitchen<select name="kitchen">${(Object.keys(KITCHENS) as Kitchen[]).map((k) => `<option value="${k}" ${k === x.kitchen ? 'selected' : ''}>${KITCHENS[k]}</option>`).join('')}</select></label>
          <label>Saturday<select name="date">${upcomingSaturdays().map((d) => `<option value="${d}" ${d === x.date ? 'selected' : ''}>${sfmt(d)}</option>`).join('')}</select></label>
          <label>Role<select name="role">${ROLES.map((y) => `<option value="${y.id}" ${y.id === x.role ? 'selected' : ''}>${y.name}</option>`).join('')}</select></label>
          <div class="srow-acts"><button type="button" class="link" data-s-x>Keep as is</button><button class="btn">Save</button></div></form></li>`;
        return `<li class="srow ${x.status}"><div><b>${sfmt(x.date)} · ${r.time}</b><small>${r.name} · ${KITCHENS[x.kitchen]}${x.status === 'waitlist' ? ' · waitlist' : ''}</small></div>
          <div class="srow-acts"><button class="link" data-s-edit="${x.id}">Change</button><button class="link danger" data-s-cancel="${x.id}">Cancel</button></div></li>`;
      };
      const cancelBox = sh.cancelling.length ? `<form class="sform cancelbox" data-s="cancel"><b>${sh.cancelling.length > 1 ? `Cancel all ${sh.cancelling.length} shifts?` : 'Cancel this shift?'}</b>
        <small class="muted">A quick reason helps the kitchen plan.</small>
        <div class="reasons">${REASONS.map((r, i) => `<label class="reason"><input type="radio" name="reason" value="${r}" ${i === 0 ? 'checked' : ''} /> ${r}</label>`).join('')}</div>
        <textarea name="comment" rows="2" placeholder="Anything else? (optional)"></textarea>
        <div class="srow-acts"><button type="button" class="link" data-s-x>Keep</button><button class="btn danger-btn">${sh.cancelling.length > 1 ? 'Cancel all' : 'Cancel shift'}</button></div></form>` : '';
      body.innerHTML = `<p class="kicker">Signed in as ${esc(email)}</p><h2 id="pop-title">Your shifts</h2>
        ${cancelBox}
        ${list.length ? `<ul class="slist">${list.slice(0, 40).map(row).join('')}</ul>` : '<p class="muted">No upcoming shifts yet.</p>'}
        <div class="srow-acts spread"><button class="btn" data-s-book>Book a shift</button>${list.length > 1 ? '<button class="link danger" data-s-all>Cancel all</button>' : ''}<button class="link" data-s-out>Sign out</button></div>`;
    }
  }
  function openShifts() {
    idx = -1; syncDots(); root.classList.add('focus'); closeSheets(); root.classList.remove('open');
    api?.focus('volunteer'); pop.dataset.kitchen = ''; shiftsCard();
    clearTimeout(openTimer); openTimer = window.setTimeout(() => { root.classList.add('open'); pop.setAttribute('aria-hidden', 'false'); }, api ? 650 : 0);
    history.replaceState(null, '', '#shifts');
  }
  document.querySelectorAll<HTMLElement>('[data-shifts]').forEach((b) => (b.onclick = openShifts));
  body.addEventListener('submit', (e) => {
    const f = e.target as HTMLFormElement, kind = f.dataset.s; if (!kind) return;
    e.preventDefault(); e.stopImmediatePropagation();
    const d = new FormData(f);
    if (kind === 'email') { sh.email = String(d.get('email')).trim().toLowerCase(); sh.code = String(Math.floor(100000 + Math.random() * 900000)); sh.step = 'code'; }
    else if (kind === 'code') { if (String(d.get('code')) !== sh.code) { f.querySelector('input')!.setCustomValidity('That code does not match'); f.reportValidity(); return; } try { localStorage.setItem(SKEY, sh.email); } catch {} sh.step = 'list'; }
    else if (kind === 'edit') { reschedule(f.dataset.id!, { kitchen: d.get('kitchen') as Kitchen, date: String(d.get('date')), role: d.get('role') as RoleId }); sh.editing = ''; }
    else if (kind === 'cancel') { const reason = [d.get('reason'), String(d.get('comment') || '').trim()].filter(Boolean).join(': '); sh.cancelling.forEach((id) => cancel(id, reason)); sh.cancelling = []; }
    shiftsCard();
  }, true);
  body.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('button'); if (!b) return;
    const D = b.dataset;
    if ('sBack' in D) { sh.step = 'email'; }
    else if (D.sEdit) { sh.editing = D.sEdit; sh.cancelling = []; }
    else if (D.sCancel) { sh.cancelling = [D.sCancel]; sh.editing = ''; }
    else if ('sAll' in D) { sh.cancelling = signupsFor(sess()!).map((x) => x.id); sh.editing = ''; }
    else if ('sX' in D) { sh.editing = ''; sh.cancelling = []; }
    else if ('sOut' in D) { try { localStorage.removeItem(SKEY); } catch {} sh.step = 'email'; }
    else if ('sBook' in D) { open('volunteer'); return; }
    else return;
    shiftsCard();
  });

  const fromHash = location.hash.slice(1) as StationId;
  if (ORDER.includes(fromHash)) open(fromHash); else if (location.hash === '#shifts') openShifts();
</script>

