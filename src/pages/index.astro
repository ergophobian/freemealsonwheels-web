---
import Base from '../layouts/Base.astro';
---
<Base title="Home">
  <section class="kitchen" id="kitchen">
    <canvas class="kitchen-canvas" id="painted" aria-hidden="true"></canvas>
    <div class="intro wrap">
      <span class="eyebrow">San Jose and San Ramon · every Saturday</span>
      <h1>Dignity starts with a full belly.</h1>
      <p class="hint-desktop">Step into our kitchen. Click the clipboard to volunteer, or the jar to give.</p>
      <p class="hint-mobile">Swipe around the kitchen and tap what you need.</p>
    </div>
    <div class="labels" id="labels">
      <button data-station="volunteer"><b>Volunteer</b><small>Pick a Saturday shift</small></button>
      <button data-station="donate"><b>Donate</b><small>$10 feeds a neighbor</small></button>
      <button data-station="about"><b>Our story</b><small>Where the meals go</small></button>
      <button data-station="resources"><b>Resources</b><small>Find a meal near you</small></button>
      <button data-station="contact"><b>Contact</b><small>Say hello</small></button>
    </div>
    <div class="swiper" id="swiper">
      <button id="prev" aria-label="Previous">‹</button>
      <span id="dots"></span>
      <button id="next" aria-label="Next">›</button>
    </div>
    <div class="quick">
      <button class="btn" data-open="volunteer">Volunteer</button>
      <button class="btn ghost" data-open="donate">Donate</button>
    </div>
    <aside class="panel" id="panel" aria-hidden="true">
      <div class="panel-bar">
        <b id="panel-title"></b>
        <a id="panel-full" href="#">Full page</a>
        <button id="panel-close" aria-label="Back to the kitchen">×</button>
      </div>
      <iframe id="panel-frame" title="Page"></iframe>
    </aside>
  </section>

  <section class="wrap impact">
    <div><strong>300+</strong><span>meals every week</span></div>
    <div><strong>400+</strong><span>volunteers</span></div>
    <div><strong>5 years</strong><span>of Saturdays</span></div>
    <div><strong>100%</strong><span>of donations go to meals</span></div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div>
        <span class="eyebrow">Volunteer</span>
        <h2>Pick a shift in 30 seconds.</h2>
        <p class="lead">Choose your kitchen, a Saturday and a role. Your spot is confirmed instantly, with a reminder the day before.</p>
        <ol class="shifts">
          <li><b>7:00 AM</b><span>Cooking and prepping</span></li>
          <li><b>9:30 AM</b><span>Packing and boxing</span></li>
          <li><b>11:00 AM</b><span>Delivery</span></li>
          <li><b>11:00 AM</b><span>Kitchen clean up</span></li>
        </ol>
        <a href="/volunteer" class="btn">See open spots</a>
      </div>
      <a class="saturday card" href="/volunteer">
        <p class="sat-head"><b id="sat-date">This Saturday</b><span>San Jose kitchen</span></p>
        <ul id="sat-roles"></ul>
        <span class="sat-cta">Book a spot →</span>
      </a>
    </div>
  </section>

  <section class="quote">
    <div class="wrap">
      <span class="mark">“</span>
      <blockquote>A fresh, hot, and nutritious meal is not just satiating, but more importantly, enabling and liberating.</blockquote>
      <p>Free Meals on Wheels mission</p>
    </div>
  </section>

  <section class="section give">
    <div class="wrap give-inner">
      <div>
        <h2>$10 feeds a neighbor tonight.</h2>
        <p>Our 100% promise: every penny of every donation goes directly to meals.</p>
      </div>
      <div class="amounts">
        {[10, 25, 50, 100].map((a) => <a href={`/donate?amount=${a}`}>${a}</a>)}
        <a href="/donate" class="btn">Donate</a>
      </div>
    </div>
  </section>
</Base>

<script>
  import { mountKitchen, type StationId } from '../lib/kitchen-scene';
  import { ROLES, upcomingSaturdays, spotsLeft } from '../lib/store';
  const ORDER: StationId[] = ['volunteer', 'donate', 'about', 'resources', 'contact'];
  const TITLES: Record<StationId, string> = { volunteer: 'Volunteer', donate: 'Donate', about: 'Our story', resources: 'Resources', contact: 'Contact' };
  const root = document.getElementById('kitchen')!, panel = document.getElementById('panel')!, frame = document.getElementById('panel-frame') as HTMLIFrameElement;
  const labels = Object.fromEntries([...document.querySelectorAll<HTMLElement>('#labels button')].map((b) => [b.dataset.station, b])) as Record<StationId, HTMLElement>;
  const mobile = () => innerWidth < 760;
  let idx = 0, openTimer = 0;

  const api = mountKitchen(document.getElementById('painted') as HTMLCanvasElement, labels, (id) => open(id));
  if (!api) root.classList.add('no-gl');

  function open(id: StationId) {
    idx = ORDER.indexOf(id); syncDots();
    api?.focus(id);
    clearTimeout(openTimer);
    openTimer = window.setTimeout(() => {
      if (!frame.src.includes(`/${id}?`)) frame.src = `/${id}?embed=1`;
      document.getElementById('panel-title')!.textContent = TITLES[id];
      (document.getElementById('panel-full') as HTMLAnchorElement).href = `/${id}`;
      root.classList.add('open'); panel.setAttribute('aria-hidden', 'false');
    }, api ? 650 : 0);
  }
  function close() {
    clearTimeout(openTimer);
    root.classList.remove('open'); panel.setAttribute('aria-hidden', 'true');
    api?.focus(mobile() ? ORDER[idx] : null);
  }
  for (const [id, el] of Object.entries(labels)) el.onclick = () => open(id as StationId);
  document.querySelectorAll<HTMLElement>('[data-open]').forEach((b) => (b.onclick = () => open(b.dataset.open as StationId)));
  document.getElementById('panel-close')!.onclick = close;
  addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });

  // Phones: swipe or tap arrows to walk between stations.
  const dots = document.getElementById('dots')!;
  dots.innerHTML = ORDER.map(() => '<i></i>').join('');
  function syncDots() { [...dots.children].forEach((d, i) => d.classList.toggle('on', i === idx)); }
  function step(d: number) { idx = (idx + d + ORDER.length) % ORDER.length; syncDots(); api?.focus(ORDER[idx]); }
  document.getElementById('prev')!.onclick = () => step(-1);
  document.getElementById('next')!.onclick = () => step(1);
  let sx = 0;
  root.addEventListener('touchstart', (e) => { sx = e.touches[0].clientX; }, { passive: true });
  root.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - sx;
    if (Math.abs(dx) > 50 && !root.classList.contains('open')) step(dx < 0 ? 1 : -1);
  }, { passive: true });
  const applyMode = () => { if (!root.classList.contains('open')) api?.focus(mobile() ? ORDER[idx] : null); };
  addEventListener('resize', applyMode); applyMode(); syncDots();
  const fromHash = location.hash.slice(1) as StationId;
  if (ORDER.includes(fromHash)) open(fromHash);

  const date = upcomingSaturdays()[0];
  document.getElementById('sat-date')!.textContent = new Date(date + 'T12:00').toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' });
  document.getElementById('sat-roles')!.innerHTML = ROLES.map((r) => {
    const left = spotsLeft('san_jose', date, r.id);
    return `<li><span><b>${r.name}</b><small>${r.time}</small></span><em class="${left ? (left <= 2 ? 'low' : '') : 'full'}">${left ? left + ' left' : 'Waitlist'}</em></li>`;
  }).join('');
</script>

<style>
  .kitchen { position: relative; height: calc(100svh - 68px); min-height: 520px; overflow: hidden; background: #f3e7d3; }
  .kitchen-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; touch-action: pan-y; }
  .intro { position: absolute; z-index: 2; left: 0; right: 0; top: 50%; transform: translateY(-50%); pointer-events: none; transition: opacity .4s; }
  .intro h1 { max-width: 14ch; font-size: clamp(2rem, 4.6vw, 3.6rem); margin: .3em 0 .2em; }
  .intro p { margin: 0; color: var(--ink); max-width: 34ch; }
  .intro .eyebrow { background: rgb(255 255 255 / .7); backdrop-filter: blur(8px); }
  .hint-mobile { display: none; }
  .kitchen::before { content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none; background: linear-gradient(90deg, rgb(246 239 226 / .92) 0%, rgb(246 239 226 / .55) 28%, transparent 46%); transition: opacity .4s; }
  .kitchen.open::before { opacity: 0; }
  .labels { position: absolute; inset: 0; z-index: 3; pointer-events: none; }
  .labels button { position: absolute; left: 0; top: 0; pointer-events: auto; display: grid; text-align: left; gap: 1px; padding: .5rem .85rem .55rem; border: 0; border-radius: 14px; background: rgb(255 253 247 / .9); backdrop-filter: blur(10px); box-shadow: 0 6px 20px rgb(60 40 20 / .16); font: inherit; color: var(--ink); cursor: pointer; transition: opacity .3s, box-shadow .2s; will-change: transform; }
  .labels button::after { content: ''; position: absolute; left: 50%; bottom: -6px; width: 12px; height: 12px; background: inherit; transform: translateX(-50%) rotate(45deg); border-radius: 2px; }
  .labels b { color: var(--green); font-weight: 650; }
  .labels small { color: var(--muted); font-size: .8rem; }
  .labels button[data-station="volunteer"] b, .labels button[data-station="donate"] b { color: var(--orange); }
  .labels button:hover, .labels :global(button.hot) { box-shadow: 0 0 0 3px var(--gold), 0 8px 24px rgb(60 40 20 / .2); }
  .labels :global(button.off) { opacity: 0; pointer-events: none; }
  .swiper, .quick { display: none; }
  .panel { position: absolute; z-index: 5; top: 12px; right: 12px; bottom: 12px; width: min(560px, calc(100% - 24px)); display: flex; flex-direction: column; background: var(--cream); border-radius: 24px; box-shadow: 0 20px 60px rgb(40 30 20 / .28); transform: translateX(calc(100% + 24px)); transition: transform .45s cubic-bezier(.2, .8, .2, 1); overflow: hidden; }
  .kitchen.open .panel { transform: none; }
  .kitchen.open .intro { opacity: 0; }
  .kitchen.open .labels, .kitchen.open .swiper { opacity: 0; pointer-events: none; }
  .panel-bar { display: flex; align-items: center; gap: 14px; padding: 12px 14px 12px 22px; border-bottom: 1px solid var(--line); }
  .panel-bar b { flex: 1; color: var(--green); font-size: 1.1rem; }
  .panel-bar a { color: var(--muted); font-size: .9rem; }
  .panel-bar button { width: 38px; height: 38px; border: 0; border-radius: 50%; background: var(--tint); color: var(--green); font-size: 1.4rem; cursor: pointer; }
  .panel iframe { flex: 1; width: 100%; border: 0; }
  .no-gl { height: auto; padding: 48px 0; }
  .no-gl .intro, .no-gl .labels { position: static; }
  .no-gl .labels { display: flex; flex-wrap: wrap; gap: 12px; padding: 24px 16px 0; max-width: 1120px; margin: 0 auto; }
  .no-gl .labels button { position: static; transform: none !important; opacity: 1 !important; }
  @media (max-width: 760px) {
    .hint-desktop { display: none; } .hint-mobile { display: block; }
    .kitchen::before { background: linear-gradient(180deg, rgb(246 239 226 / .92) 0%, rgb(246 239 226 / .5) 26%, transparent 40%); }
    .intro { top: 20px; transform: none; }
    .intro h1 { font-size: 2rem; }
    .swiper { display: flex; position: absolute; z-index: 3; left: 0; right: 0; bottom: 88px; justify-content: center; align-items: center; gap: 14px; }
    .swiper button { width: 40px; height: 40px; border: 0; border-radius: 50%; background: rgb(255 253 247 / .85); color: var(--green); font-size: 1.5rem; }
    #dots { display: flex; gap: 6px; }
    #dots :global(i) { width: 7px; height: 7px; border-radius: 50%; background: rgb(31 77 52 / .25); transition: width .2s; }
    #dots :global(i.on) { width: 20px; border-radius: 4px; background: var(--green); }
    .quick { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; position: absolute; z-index: 3; left: 16px; right: 16px; bottom: 20px; }
    .quick .btn { justify-content: center; }
    .quick .btn.ghost { background: rgb(255 253 247 / .9); }
    .panel { top: auto; left: 0; right: 0; bottom: 0; width: 100%; height: 88%; border-radius: 24px 24px 0 0; transform: translateY(105%); }
  }
  @media (prefers-reduced-motion: reduce) { .panel { transition: none; } }

  .saturday { display: block; text-decoration: none; padding: 26px; }
  .sat-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin: 0 0 14px; flex-wrap: wrap; }
  .sat-head b { font-size: 1.2rem; color: var(--green); }
  .sat-head span { color: var(--muted); font-size: .9rem; }
  .saturday ul { list-style: none; padding: 0; margin: 0 0 18px; }
  .saturday :global(li) { display: flex; justify-content: space-between; align-items: center; padding: 12px 0; border-top: 1px solid var(--line); }
  .saturday :global(li span) { display: grid; }
  .saturday :global(small) { color: var(--muted); }
  .saturday :global(em) { font-style: normal; font-size: .85rem; font-weight: 600; padding: .3rem .75rem; border-radius: 99px; background: rgb(47 107 74 / .12); color: var(--green-2); }
  .saturday :global(em.low) { background: rgb(232 104 28 / .14); color: #b4500f; }
  .saturday :global(em.full) { background: var(--tint); color: var(--muted); }
  .sat-cta { color: var(--orange); font-weight: 600; }

  .impact { position: relative; z-index: 2; margin-top: 0; margin-top: 32px; display: grid; grid-template-columns: repeat(4, 1fr); background: var(--surface); backdrop-filter: blur(20px) saturate(1.3); border: 1px solid var(--glass-line); border-radius: var(--radius); box-shadow: var(--shadow); }
  .impact div { padding: 26px 20px; text-align: center; }
  .impact div + div { border-left: 1px solid var(--line); }
  .impact strong { display: block; font-size: 2.2rem; font-weight: 700; letter-spacing: -.03em; color: var(--green); }
  .impact span { color: var(--muted); font-size: .95rem; }
  @media (max-width: 720px) { .impact { grid-template-columns: 1fr 1fr; } .impact div:nth-child(3) { border-left: 0; } .impact div:nth-child(n+3) { border-top: 1px solid var(--line); } }

  .split { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
  @media (max-width: 860px) { .split { grid-template-columns: 1fr; } }
  .shifts { list-style: none; padding: 0; margin: 24px 0 28px; display: grid; gap: 8px; }
  .shifts li { display: flex; gap: 16px; padding: 12px 16px; border-radius: 14px; background: var(--tint); }
  .shifts b { color: var(--green); min-width: 76px; }

  .quote { background: var(--green); color: #fff; padding: clamp(64px, 10vw, 120px) 0; text-align: center; }
  .quote .mark { display: block; font-size: 5rem; line-height: .6; color: var(--gold); margin-bottom: 12px; }
  .quote blockquote { margin: 0 auto; max-width: 28ch; font-size: clamp(1.6rem, 3.6vw, 2.5rem); font-weight: 600; letter-spacing: -.02em; line-height: 1.25; }
  .quote p { color: var(--gold); margin-top: 20px; }


  .give { padding-top: 0; }
  .give-inner { display: flex; align-items: center; justify-content: space-between; gap: 28px; flex-wrap: wrap; padding: clamp(28px, 5vw, 48px); border-radius: 28px; background: linear-gradient(135deg, #fff1e4, #fde3cc); }
  .give h2 { margin-bottom: .2em; }
  .give p { color: var(--muted); margin: 0; }
  .amounts { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  .amounts a:not(.btn) { padding: .8rem 1.2rem; border-radius: 999px; background: #fff; text-decoration: none; font-weight: 600; color: var(--green); box-shadow: var(--shadow); }
  @media (prefers-color-scheme: dark) { .give-inner { background: linear-gradient(135deg, #2a1d12, #3a2614); } .amounts a:not(.btn) { background: var(--soft); color: var(--ink); } }
</style>
