---
import Base from '../layouts/Base.astro';
const programs = [
  { img: '/img/blanket.webp', title: 'Meal and a blanket', text: 'Winters are hard on our unhoused neighbors. A hot meal and a warm blanket, delivered together.', href: '/donate#winter', cta: 'Give warmth' },
  { img: '/img/thanksgiving.webp', title: 'Thanksgiving meal drive', text: 'A full holiday plate for families who would otherwise go without.', href: '/donate', cta: 'Sponsor a plate' },
  { img: '/img/team.webp', title: 'Give time, build a team', text: 'Bring your company for a morning of cooking and giving back.', href: '/volunteer', cta: 'Plan a team day' },
  { img: '/img/serving.jpg', title: 'Celebrate with us', text: 'Turn a birthday or anniversary into a morning that feeds hundreds.', href: '/volunteer', cta: 'Book a celebration' },
];
---
<Base title="Home">
  <section class="hero">
    <img class="hero-img" src="/img/kitchen.webp" alt="Volunteers serving hot meals in the Free Meals on Wheels kitchen" />
    <div class="wrap hero-inner">
      <h1>Dignity starts with a full belly.</h1>
      <p>Every Saturday, our volunteers cook, pack and deliver fresh, hot meals to neighbors across San Jose and San Ramon.</p>
      <div class="actions">
        <a href="/volunteer" class="btn">Volunteer this Saturday</a>
        <a href="/donate" class="btn light">Donate a meal</a>
      </div>
    </div>
  </section>

  <section class="wrap impact">
    <div><strong>300+</strong><span>meals every week</span></div>
    <div><strong>400+</strong><span>volunteers</span></div>
    <div><strong>5 years</strong><span>of Saturdays</span></div>
    <div><strong>100%</strong><span>of donations go to meals</span></div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div>
        <span class="eyebrow">Volunteer</span>
        <h2>Pick a shift in 30 seconds.</h2>
        <p class="lead">Choose your kitchen, a Saturday and a role. Your spot is confirmed instantly, with a reminder the day before.</p>
        <ol class="shifts">
          <li><b>7:00 AM</b><span>Cooking and prepping</span></li>
          <li><b>9:30 AM</b><span>Packing and boxing</span></li>
          <li><b>11:00 AM</b><span>Delivery</span></li>
          <li><b>11:00 AM</b><span>Kitchen clean up</span></li>
        </ol>
        <a href="/volunteer" class="btn">See open spots</a>
      </div>
      <figure class="photo-stack">
        <img src="/img/smile.webp" alt="A smiling neighbor receiving a meal" />
        <img src="/img/boxes.jpg" alt="Volunteers packing boxes" />
      </figure>
    </div>
  </section>

  <section class="quote">
    <div class="wrap">
      <span class="mark">“</span>
      <blockquote>A fresh, hot, and nutritious meal is not just satiating, but more importantly, enabling and liberating.</blockquote>
      <p>Free Meals on Wheels mission</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <span class="eyebrow">Programs</span>
      <h2>More ways we show up</h2>
      <div class="programs">
        {programs.map((p) => (
          <a class="program" href={p.href}>
            <img src={p.img} alt="" loading="lazy" />
            <div><h3>{p.title}</h3><p>{p.text}</p><span>{p.cta} →</span></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section give">
    <div class="wrap give-inner">
      <div>
        <h2>$10 feeds a neighbor tonight.</h2>
        <p>Our 100% promise: every penny of every donation goes directly to meals.</p>
      </div>
      <div class="amounts">
        {[10, 25, 50, 100].map((a) => <a href={`/donate?amount=${a}`}>${a}</a>)}
        <a href="/donate" class="btn">Donate</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { position: relative; min-height: min(88vh, 760px); display: grid; align-items: end; color: #fff; overflow: hidden; }
  .hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgb(15 38 25 / .15) 20%, rgb(15 38 25 / .88) 100%); }
  .hero-inner { position: relative; z-index: 1; padding: 120px 0 72px; }
  .hero h1 { color: #fff; max-width: 14ch; font-size: clamp(2.6rem, 7vw, 5rem); }
  .hero p { font-size: 1.2rem; max-width: 52ch; color: rgb(255 255 255 / .88); }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .btn.light { background: rgb(255 255 255 / .16); backdrop-filter: blur(12px); box-shadow: inset 0 0 0 1px rgb(255 255 255 / .4); }

  .impact { position: relative; z-index: 2; margin-top: -40px; display: grid; grid-template-columns: repeat(4, 1fr); background: var(--surface); backdrop-filter: blur(20px) saturate(1.3); border: 1px solid var(--glass-line); border-radius: var(--radius); box-shadow: var(--shadow); }
  .impact div { padding: 26px 20px; text-align: center; }
  .impact div + div { border-left: 1px solid var(--line); }
  .impact strong { display: block; font-size: 2.2rem; font-weight: 700; letter-spacing: -.03em; color: var(--green); }
  .impact span { color: var(--muted); font-size: .95rem; }
  @media (max-width: 720px) { .impact { grid-template-columns: 1fr 1fr; } .impact div:nth-child(3) { border-left: 0; } .impact div:nth-child(n+3) { border-top: 1px solid var(--line); } }

  .split { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
  @media (max-width: 860px) { .split { grid-template-columns: 1fr; } }
  .shifts { list-style: none; padding: 0; margin: 24px 0 28px; display: grid; gap: 8px; }
  .shifts li { display: flex; gap: 16px; padding: 12px 16px; border-radius: 14px; background: var(--tint); }
  .shifts b { color: var(--green); min-width: 76px; }
  .photo-stack { position: relative; margin: 0; aspect-ratio: 1 / 1; }
  .photo-stack img { position: absolute; border-radius: 24px; object-fit: cover; box-shadow: var(--shadow); }
  .photo-stack img:first-child { inset: 0 18% 22% 0; width: 82%; height: 78%; }
  .photo-stack img:last-child { inset: 40% 0 0 34%; width: 66%; height: 60%; border: 6px solid var(--bg); }

  .quote { background: var(--green); color: #fff; padding: clamp(64px, 10vw, 120px) 0; text-align: center; }
  .quote .mark { display: block; font-size: 5rem; line-height: .6; color: var(--gold); margin-bottom: 12px; }
  .quote blockquote { margin: 0 auto; max-width: 28ch; font-size: clamp(1.6rem, 3.6vw, 2.5rem); font-weight: 600; letter-spacing: -.02em; line-height: 1.25; }
  .quote p { color: var(--gold); margin-top: 20px; }

  .programs { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin-top: 12px; }
  .program { display: grid; text-decoration: none; background: var(--surface); border: 1px solid var(--glass-line); border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); transition: transform .2s; }
  .program:hover { transform: translateY(-3px); }
  .program img { aspect-ratio: 4 / 3; object-fit: cover; width: 100%; }
  .program div { padding: 20px 22px 24px; }
  .program p { color: var(--muted); margin: 0 0 12px; }
  .program span { color: var(--orange); font-weight: 600; }

  .give { padding-top: 0; }
  .give-inner { display: flex; align-items: center; justify-content: space-between; gap: 28px; flex-wrap: wrap; padding: clamp(28px, 5vw, 48px); border-radius: 28px; background: linear-gradient(135deg, #fff1e4, #fde3cc); }
  .give h2 { margin-bottom: .2em; }
  .give p { color: var(--muted); margin: 0; }
  .amounts { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  .amounts a:not(.btn) { padding: .8rem 1.2rem; border-radius: 999px; background: #fff; text-decoration: none; font-weight: 600; color: var(--green); box-shadow: var(--shadow); }
  @media (prefers-color-scheme: dark) { .give-inner { background: linear-gradient(135deg, #2a1d12, #3a2614); } .amounts a:not(.btn) { background: var(--soft); color: var(--ink); } }
</style>
