---
import Base from '../layouts/Base.astro';
---
<Base title="Home">
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">San Jose and San Ramon kitchens</p>
        <h1>Fresh, free meals for every neighbor.</h1>
        <p class="lead">We believe in the innate dignity of the human spirit, regardless of circumstances. Every Saturday our volunteers cook, pack and deliver hot meals to people who need them.</p>
        <div class="actions">
          <a href="/donate" class="btn">Donate a meal</a>
          <a href="/volunteer" class="btn ghost">Volunteer this Saturday</a>
        </div>
      </div>
      <div class="hero-art" aria-hidden="true">
        <img src="/logo.png" alt="" />
      </div>
    </div>
  </section>

  <section class="wrap stats">
    <div><strong>300+</strong><span>meals every week</span></div>
    <div><strong>400+</strong><span>volunteers</span></div>
    <div><strong>100%</strong><span>of donations to meals</span></div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Three ways to help</h2>
      <div class="grid">
        <article class="card"><h3>Sponsor a meal</h3><p class="muted">Fund one meal or many, once or every month.</p><a href="/donate">Give now →</a></article>
        <article class="card"><h3>Meal and a blanket</h3><p class="muted">Our winter drive brings warmth and food to unhoused neighbors.</p><a href="/donate#winter">Join the drive →</a></article>
        <article class="card"><h3>Cook with us</h3><p class="muted">Saturday shifts for individuals, families, birthdays and corporate teams.</p><a href="/volunteer">See shifts →</a></article>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap how">
      <h2>How a Saturday works</h2>
      <ol>
        <li><b>7:00 AM</b> Cooking and prepping</li>
        <li><b>9:30 AM</b> Packing and boxing</li>
        <li><b>11:00 AM</b> Delivery and kitchen clean up</li>
        <li><b>1:00 PM</b> Every meal delivered</li>
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap cta card">
      <div>
        <h2>$10 feeds a neighbor tonight.</h2>
        <p class="muted">Every penny of every donation goes directly to impact programming.</p>
      </div>
      <a href="/donate" class="btn">Donate</a>
    </div>
  </section>
</Base>

<style>
  .hero { padding: clamp(48px, 8vw, 96px) 0; background: radial-gradient(60% 80% at 85% 30%, color-mix(in srgb, var(--brand) 14%, transparent), transparent); }
  .hero-grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: 40px; align-items: center; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .hero-art { background: var(--surface); border-radius: 32px; aspect-ratio: 1; display: grid; place-items: center; box-shadow: var(--shadow); }
  .hero-art img { width: 60%; }
  @media (max-width: 820px) { .hero-grid { grid-template-columns: 1fr; } .hero-art { display: none; } }
  .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .stats div { background: var(--surface); border-radius: var(--radius); padding: 24px; text-align: center; box-shadow: var(--shadow); }
  .stats strong { display: block; font: 700 2.2rem Fraunces, serif; color: var(--brand); }
  .stats span { color: var(--muted); }
  @media (max-width: 600px) { .stats { grid-template-columns: 1fr; } }
  .how ol { list-style: none; padding: 0; display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
  .how li { background: var(--surface); padding: 22px; border-radius: var(--radius); border-left: 4px solid var(--accent); }
  .how b { display: block; color: var(--accent); }
  .cta { display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  .cta h2 { margin-bottom: .2em; }
  .card a { color: var(--brand); font-weight: 600; text-decoration: none; }
</style>
