---
// Home page, told as one meal's journey. The pictures are people, drawn live by code (src/lib/ink) in the manner of
// the logo: a loose ink line over lavender, butter, mint and sage. Below the hero a road runs down the page from the
// kitchen to a family's table; it is traced as you scroll and a small van follows it. No images or video besides the logo.
import HearthLayout from '../layouts/HearthLayout.astro';
const B = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const MAIL = 'mailto:info@freemealsonwheels.com';
const arrow = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"/></svg>';
const stops = [
  { scene: 'kitchen', seed: 11, time: '6:00 in the morning', h: 'The kitchen wakes', lead: 'Before the city is up, the first pot goes on.', p: 'Volunteers of every age cook together in our San Jose and San Ramon kitchens, the same morning the food goes out. Never frozen, never days old.', alt: 'An ink drawing of volunteers cooking around a large steaming pot while a child carries in vegetables.' },
  { scene: 'pack', seed: 12, time: '9:30', h: 'Packed by hand', lead: 'Every meal passes through a neighbor’s hands.', p: 'Each one is filled, checked and sealed while it is still hot, then stacked by the door for the drivers.', alt: 'An ink drawing of three volunteers at a long table filling and stacking meal boxes, with a child carrying a bag.' },
  { scene: 'van', seed: 13, time: '10:30', h: 'On the road', lead: 'Families load their cars and head out.', p: 'Drivers fan out across both cities. Many bring their children along, so the next generation learns what a weekend morning is for.', alt: 'An ink drawing of a volunteer and a child loading meal boxes into a van.' },
  { scene: 'knock', seed: 14, time: '11:00 to 1:00', h: 'A knock at the door', lead: 'Someone is already waiting.', p: 'The meal is handed over at the door, still warm, with a hello and a few minutes to talk. No forms, and no one asking why.', alt: 'An ink drawing of a volunteer and her child handing a warm meal to an elderly woman at her front door.' },
  { scene: 'table', seed: 15, time: 'That evening', h: 'A full table', lead: 'Tonight a family eats together.', p: 'Grandparents, parents and children around one table, with nothing to worry about until morning. This is what the whole morning was for.', alt: 'An ink drawing of a family of five sharing a hot meal around a table under a lamp.' },
];
---
<HearthLayout title="Free Meals on Wheels: bringing smiles, one meal at a time" fullTitle>
  <section class="hero" id="top">
    <div class="wrap hero-in">
      <div class="hero-body">
        <p class="hand when">Saturdays in San Jose, Sundays in San Ramon</p>
        <h1>Dignity starts with <em>a&nbsp;full&nbsp;belly.</em></h1>
        <p class="sub">Neighbors cook a fresh, hot meal in the morning and carry it to a family&rsquo;s door by noon. Fifteen hundred meals a week, always free.</p>
        <div class="acts">
          <a class="btn gold" href={`${B}donate`}>Give a meal</a>
          <a class="quiet" href={`${B}volunteer`}>Volunteer for a morning <Fragment set:html={arrow} /></a>
        </div>
        <a class="need" href={`${B}get-a-meal`}><b>Need a meal?</b> It&rsquo;s free, and no one will ask why. <span>Request one <Fragment set:html={arrow} /></span></a>
      </div>
      <figure class="hero-art">
        <canvas data-scene="door" data-seed="7" role="img" aria-label="An ink drawing of a volunteer and a child handing a warm meal to a mother, her daughter and a grandfather at their front door."></canvas>
      </figure>
    </div>
  </section>

  <section class="intro">
    <div class="wrap">
      <dl class="figs" data-rv>
        <div><dt><span>400+</span></dt><dd>volunteers who give up a weekend morning</dd></div>
        <div><dt><span>1,500</span></dt><dd>meals cooked and delivered each week</dd></div>
        <div><dt><span>100%</span></dt><dd>of every donation goes to food</dd></div>
      </dl>
    </div>
  </section>

  <section class="story" id="story" aria-labelledby="story-h">
    <div class="wrap">
      <header class="story-h" data-rv>
        <p class="hand">Follow one meal</p>
        <h2 id="story-h" class="big">From our stove to a family&rsquo;s table</h2>
        <p>One morning, start to finish. Scroll down the road.</p>
      </header>
      <div class="road">
        <svg class="road-svg" aria-hidden="true">
          <defs><mask id="road-mask" maskUnits="userSpaceOnUse"><path class="road-go" fill="none" stroke="#fff" stroke-linecap="round" /></mask></defs>
          <path class="road-bed" fill="none" stroke-linecap="round" />
          <path class="road-faint" fill="none" stroke-linecap="round" />
          <path class="road-line" fill="none" stroke-linecap="round" mask="url(#road-mask)" />
        </svg>
        <div class="road-van" aria-hidden="true">
          <svg viewBox="0 0 64 44" fill="none" stroke="#1c1a22" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 33V13l3-4h28l7 10 13 3v11z" fill="#fff" />
            <path d="M8 25h50v6H8z" fill="#94c8b8" stroke="none" transform="translate(1.5 1.2)" />
            <path d="M32 12h4l5 7h-9zM17 12h11v7H17z" fill="#f2d988" />
            <path d="M4 33h56" />
            <circle cx="17" cy="34" r="5.4" fill="#322c3b" /><circle cx="45" cy="34" r="5.4" fill="#322c3b" />
            <circle cx="17" cy="34" r="1.6" fill="#fff" stroke="none" /><circle cx="45" cy="34" r="1.6" fill="#fff" stroke="none" />
          </svg>
        </div>
        <ol class="stops">
          {stops.map((m, i) => (
            <li class:list={['stop', { flip: i % 2 === 1 }]}>
              <figure data-rv><canvas data-scene={m.scene} data-seed={m.seed} role="img" aria-label={m.alt}></canvas></figure>
              <span class="pin" aria-hidden="true">{i + 1}</span>
              <div class="txt" data-rv style="--rd:.12s">
                <p class="hand time">{m.time}</p>
                <h3>{m.h}</h3>
                <p class="lead">{m.lead}</p>
                <p>{m.p}</p>
              </div>
            </li>
          ))}
        </ol>
        <p class="road-end hand" data-rv>and next weekend, we do it all again</p>
      </div>
    </div>
  </section>

  <section class="people" aria-labelledby="people-h">
    <svg class="edge" viewBox="0 0 1200 40" preserveAspectRatio="none" aria-hidden="true"><path d="M0 40V22c80-14 150-16 240-8s170 18 270 12 190-22 290-20 170 16 250 14 110-8 150-6v26z" /></svg>
    <div class="wrap people-in">
      <div class="people-txt" data-rv>
        <h2 id="people-h">Fifteen hundred meals a week. Each one is someone.</h2>
        <p>Each face here stands for five neighbors we will bring a meal to this weekend. The last one is still waiting. Ten dollars gets a meal to their door.</p>
        <div class="give">
          <a class="btn gold" href={`${B}donate?freq=once&amt=10`}>Give $10</a>
          <a class="chip" href={`${B}donate?freq=once&amt=50`}>$50</a>
          <a class="chip" href={`${B}donate?freq=once&amt=100`}>$100</a>
          <a class="chip" href={`${B}donate?freq=monthly&amt=25`}>Monthly</a>
        </div>
        <p class="fine-d">Tax-deductible. Every penny goes to food.</p>
      </div>
      <a class="crowd" href={`${B}donate?freq=once&amt=10`} aria-label="Three hundred faces drawn in ink, each standing for five neighbors. The last one is an empty outline. Give ten dollars to bring them a meal.">
        <canvas data-scene="crowd" data-seed="21"></canvas>
      </a>
    </div>
    <svg class="edge flip" viewBox="0 0 1200 40" preserveAspectRatio="none" aria-hidden="true"><path d="M0 40V22c80-14 150-16 240-8s170 18 270 12 190-22 290-20 170 16 250 14 110-8 150-6v26z" /></svg>
  </section>

  <section class="quote">
    <div class="wrap">
      <span class="mark" aria-hidden="true">&ldquo;</span>
      <blockquote data-rv>A fresh, hot, and nutritious meal is not just satiating, but more importantly, enabling and liberating.</blockquote>
      <p><b>Japjot Sethi and Devinder Kumar</b>, founders. <a class="link" href={`${B}about`}>Read our story</a></p>
    </div>
  </section>

  <section class="sec table" aria-labelledby="table-h">
    <div class="wrap">
      <p class="hand" data-rv>Three ways in</p>
      <h2 id="table-h" class="big" data-rv>Come to the table</h2>
      <div class="ways" data-rv>
        <article style="--c:var(--lav)">
          <p class="hand time">Volunteer</p>
          <h3>Give a weekend morning</h3>
          <p>Pick a kitchen, a date and a role: cooking, packing, delivering or cleaning up. Bring your family. Your spot is confirmed instantly.</p>
          <a class="more" href={`${B}volunteer`}>Pick a shift <Fragment set:html={arrow} /></a>
        </article>
        <article style="--c:var(--mint)">
          <p class="hand time">Get a meal</p>
          <h3>A hot meal, free</h3>
          <p>For any family that needs one. Tell us where to bring it and how many are at your table. No one will ask why.</p>
          <a class="more" href={`${B}get-a-meal`}>Request a meal <Fragment set:html={arrow} /></a>
        </article>
        <article style="--c:var(--butter)">
          <p class="hand time">Donate</p>
          <h3>Ten dollars is one meal</h3>
          <p>Every penny goes to food. One-time or monthly, and tax-deductible. We are a 501(c)(3).</p>
          <a class="more" href={`${B}donate`}>Give a meal <Fragment set:html={arrow} /></a>
        </article>
      </div>
      <div class="know" data-rv>
        <p><b>First time?</b> Wear closed-toe shoes, tie back long hair and arrive ten minutes early.</p>
        <p><b>A group of 7 or more?</b> <a href={`${MAIL}?subject=Group%20volunteering`}>Email us</a> and we will set aside a kitchen for your team.</p>
        <p><b>Can&rsquo;t get out?</b> Dial 211 for food, housing and health services near you.</p>
      </div>
    </div>
  </section>
</HearthLayout>

<script>
  // The road: a path through the numbered pins, traced as the page scrolls, with a van at its tip.
  const road = document.querySelector<HTMLElement>('.road');
  const svg = road?.querySelector<SVGSVGElement>('.road-svg');
  if (road && svg) {
    const paths = [...svg.querySelectorAll<SVGPathElement>('path')];
    const go = svg.querySelector<SVGPathElement>('.road-go')!;
    const van = road.querySelector<HTMLElement>('.road-van')!;
    const pins = [...road.querySelectorAll<HTMLElement>('.pin')];
    const fx = document.documentElement.classList.contains('fx-on');
    let L = 0, at: number[] = [];
    const build = () => {
      const R = road.getBoundingClientRect(), W = R.width, H = R.height;
      svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
      const pts = pins.map((p) => { const r = p.getBoundingClientRect(); return [r.left + r.width / 2 - R.left, r.top + r.height / 2 - R.top]; });
      const all = [[pts[0][0], 0], ...pts, [pts[pts.length - 1][0] + (W > 700 ? 0 : 0), H - 26]];
      let d = `M${all[0][0]} ${all[0][1]}`;
      for (let i = 1; i < all.length; i++) { const a = all[i - 1], b = all[i], m = (a[1] + b[1]) / 2; d += ` C${a[0]} ${m} ${b[0]} ${m} ${b[0]} ${b[1]}`; }
      paths.forEach((p) => p.setAttribute('d', d));
      L = go.getTotalLength();
      go.style.strokeDasharray = `${L}`;
      // how far along the road each pin sits
      at = pts.map((pt) => { let lo = 0, hi = L; for (let k = 0; k < 22; k++) { const m = (lo + hi) / 2; if (go.getPointAtLength(m).y < pt[1]) lo = m; else hi = m; } return lo; });
      tick();
    };
    const tick = () => {
      const R = road.getBoundingClientRect();
      const p = fx ? Math.max(0, Math.min(1, (innerHeight * 0.62 - R.top) / R.height)) : 1;
      go.style.strokeDashoffset = `${L * (1 - p)}`;
      pins.forEach((pin, i) => pin.classList.toggle('on', p * L >= at[i] - 4));
      if (!fx) return;
      const a = go.getPointAtLength(p * L), b = go.getPointAtLength(Math.min(L, p * L + 24));
      van.style.transform = `translate(${a.x}px, ${a.y}px) translate(-50%, -62%) scaleX(${b.x < a.x - 0.5 ? -1 : 1})`;
      van.classList.toggle('show', p > 0.004 && p < 0.996);
    };
    let q = false;
    const onScroll = () => { if (q) return; q = true; requestAnimationFrame(() => { q = false; tick(); }); };
    build();
    addEventListener('scroll', onScroll, { passive: true });
    new ResizeObserver(build).observe(road);
  }
</script>

<style>
  .hand { font-family: var(--hand); font-weight: 600; font-size: clamp(25px, 2.2vw, 30px); line-height: 1.1; color: var(--mint-deep); }

  /* ---------- hero: a meal handed to a family ---------- */
  .hero { background: radial-gradient(60% 70% at 78% 40%, var(--butter-tint), transparent 70%), linear-gradient(var(--lav-tint), var(--paper) 78%); }
  .hero-in { display: grid; grid-template-columns: minmax(0, 0.82fr) minmax(0, 1fr); gap: clamp(24px, 3vw, 56px); align-items: center; padding-top: clamp(28px, 4vw, 56px); padding-bottom: clamp(40px, 5vw, 72px); }
  .when { margin-bottom: 14px; }
  .hero h1 { font-size: clamp(44px, 5vw, 76px); line-height: 1.02; letter-spacing: -0.02em; text-wrap: balance; }
  .hero h1 em { font-family: var(--serif); font-style: italic; color: var(--lav-deep); letter-spacing: -0.01em; background: linear-gradient(var(--butter), var(--butter)) no-repeat 6px 88% / 100% 0.26em; }
  .sub { margin-top: 26px; max-width: 26em; font-size: clamp(18px, 1.5vw, 21px); line-height: 1.55; color: var(--text); }
  .acts { display: flex; align-items: center; flex-wrap: wrap; gap: 18px 30px; margin-top: 34px; }
  .acts .btn { min-width: 190px; font-size: 18px; }
  .quiet { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); font-weight: 600; text-decoration: none; border-bottom: 2px solid var(--mint); padding-bottom: 3px; }
  .quiet:hover { border-color: var(--ink); }
  .quiet :global(svg), .need :global(svg), .more :global(svg) { width: 16px; height: 16px; flex: none; }
  .need { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 10px; margin-top: 40px; padding-top: 22px; border-top: 1px dashed var(--edge); color: var(--text); text-decoration: none; font-size: 16.5px; max-width: 30em; }
  .need b { color: var(--ink); font-weight: 700; }
  .need span { display: inline-flex; align-items: center; gap: 8px; color: var(--lav-deep); font-weight: 700; }
  .need:hover span { text-decoration: underline; text-underline-offset: 4px; }
  .hero-art { margin: 0; }
  .hero-art figcaption { margin-top: 2px; text-align: right; font-size: 21px; font-weight: 500; color: var(--muted); }

  /* ---------- three numbers ---------- */
  .intro { padding: clamp(36px, 5vw, 64px) 0 0; }
  .figs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; margin: 0; }
  .figs dt { font-family: var(--head); font-size: clamp(46px, 5vw, 70px); line-height: 1; color: var(--ink); }
  .figs dt span { background: linear-gradient(var(--c, var(--lav)), var(--c, var(--lav))) no-repeat 8px 82% / 100% 0.34em; padding-right: 8px; }
  .figs div:nth-child(2) { --c: var(--butter); }
  .figs div:nth-child(3) { --c: var(--mint); }
  .figs dd { margin: 14px 0 0; max-width: 15em; color: var(--muted); font-size: 17.5px; }

  /* ---------- the road ---------- */
  .story { padding: clamp(72px, 9vw, 130px) 0 clamp(40px, 5vw, 70px); }
  .story-h { text-align: center; margin-bottom: clamp(20px, 3vw, 40px); }
  .story-h h2 { margin: 6px auto 14px; max-width: 14em; text-wrap: balance; }
  .story-h > p:last-child { color: var(--muted); }
  .road { position: relative; padding: 70px 0 110px; }
  .road-svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
  .road-bed { stroke: var(--lav-tint); stroke-width: 34; }
  .road-faint { stroke: var(--edge); stroke-width: 2.5; stroke-dasharray: 1 13; opacity: 0.6; }
  .road-line { stroke: var(--ink); stroke-width: 3; stroke-dasharray: 14 12; }
  .road-go { stroke-width: 12; }
  .road-van { position: absolute; left: 0; top: 0; width: 64px; z-index: 2; opacity: 0; transition: opacity 0.3s ease; pointer-events: none; will-change: transform; }
  .road-van.show { opacity: 1; }
  .road-van svg { display: block; width: 100%; }
  .stops { position: relative; list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(64px, 8vw, 120px); }
  .stop { display: grid; grid-template-columns: minmax(0, 1fr) 190px minmax(0, 1fr); align-items: center; }
  .stop figure { margin: 0; grid-column: 1; grid-row: 1; }
  .stop .pin { grid-column: 2; grid-row: 1; justify-self: center; translate: -48px 0; }
  .stop .txt { grid-column: 3; grid-row: 1; }
  .stop.flip figure { grid-column: 3; }
  .stop.flip .txt { grid-column: 1; justify-self: end; }
  .stop.flip .pin { translate: 48px 0; }
  .pin { position: relative; z-index: 1; display: grid; place-items: center; width: 50px; height: 50px; background: var(--paper); border: 2px solid var(--ink); border-radius: 52% 48% 50% 50% / 48% 52% 48% 52%; font-family: var(--head); font-size: 22px; color: var(--ink); transition: background-color 0.4s ease, box-shadow 0.4s ease; }
  .pin.on { background: var(--butter); box-shadow: 4px 4px 0 var(--mint); }
  .time { margin-bottom: 6px; }
  .stop h3 { font-size: clamp(36px, 3.8vw, 54px); line-height: 1.04; color: var(--ink); }
  .stop .lead { margin: 16px 0 12px; font-family: var(--serif); font-style: italic; font-size: clamp(22px, 2vw, 27px); line-height: 1.3; color: var(--ink); }
  .stop .txt { max-width: 25em; }
  .stop .txt > p:last-child { color: var(--text); }
  .road-end { position: absolute; left: 0; right: 0; bottom: 34px; text-align: center; }
  .road-end::before { content: ""; display: block; width: 14px; height: 14px; margin: 0 auto 30px; }

  /* ---------- three hundred neighbors ---------- */
  .people { position: relative; background: var(--lav-tint); margin: 40px 0; }
  .edge { position: absolute; left: 0; bottom: 100%; width: 100%; height: 40px; display: block; fill: var(--lav-tint); margin-bottom: -1px; }
  .edge.flip { bottom: auto; top: 100%; transform: scaleY(-1); margin: -1px 0 0; }
  .people-in { display: grid; grid-template-columns: 1fr 1.35fr; gap: clamp(32px, 5vw, 72px); align-items: center; padding-block: clamp(56px, 6vw, 96px); }
  .people h2 { font-size: clamp(36px, 4.2vw, 58px); line-height: 1.06; text-wrap: balance; }
  .people-txt > p:first-of-type { margin-top: 22px; font-size: 19px; max-width: 26em; }
  .give { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .chip { display: inline-flex; align-items: center; min-height: 54px; padding: 0 22px; border-radius: var(--wob); border: 1.75px solid var(--ink); color: var(--ink); background: var(--paper); text-decoration: none; font-weight: 700; }
  .chip:hover { background: var(--mint); }
  .fine-d { margin-top: 18px; font-size: 15.5px; color: var(--muted); }
  .crowd { display: block; }

  /* ---------- come to the table ---------- */
  .quote { margin-top: 40px; }
  .table > .wrap > .hand { margin-bottom: 4px; }
  .ways { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; margin-top: 40px; }
  .ways article { display: flex; flex-direction: column; gap: 12px; padding: 28px 28px 30px; border: 1.75px solid var(--ink); border-radius: var(--wob); background: linear-gradient(var(--c), var(--c)) no-repeat 8px 8px / 100% 9px, var(--paper); }
  .ways .time { margin: 6px 0 0; font-size: 27px; }
  .ways h3 { font-size: clamp(27px, 2.5vw, 34px); line-height: 1.1; }
  .ways p:not(.time) { color: var(--text); flex: 1; }
  .ways .more { align-self: flex-start; margin-top: 8px; }
  .know { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; margin-top: 48px; padding-top: 28px; border-top: 1px dashed var(--edge); font-size: 16px; color: var(--muted); }
  .know b { color: var(--ink); }
  .know a { color: var(--night); font-weight: 600; }

  @media (max-width: 900px) {
    .hero-in { grid-template-columns: 1fr; }
    .hero-art { max-width: 560px; margin: 0 auto; width: 100%; }
    .road { padding: 50px 0 100px; }
    .road-bed { stroke-width: 22; }
    .stop, .stop.flip { grid-template-columns: 58px minmax(0, 1fr); column-gap: 10px; row-gap: 14px; align-items: start; }
    .stop figure, .stop.flip figure { grid-column: 2; grid-row: 1; }
    .stop .txt, .stop.flip .txt { grid-column: 2; grid-row: 2; justify-self: start; }
    .stop .pin, .stop.flip .pin { grid-column: 1; grid-row: 1; justify-self: start; align-self: center; width: 42px; height: 42px; font-size: 19px; translate: 0 0; }
    .stop.flip .pin { translate: 12px 0; }
    .road-van { width: 46px; }
    .people-in { grid-template-columns: 1fr; }
    .ways, .know { grid-template-columns: 1fr; }
    .know { gap: 16px; }
    .figs { grid-template-columns: 1fr; gap: 22px; }
    .figs div { display: grid; grid-template-columns: 150px 1fr; align-items: center; gap: 16px; }
    .figs dd { margin: 0; }
  }
  @media (max-width: 760px) {
    .hero-in { padding-top: 20px; }
    .acts .btn { width: 100%; }
    .need { font-size: 15.5px; margin-top: 28px; }
    .hero-art figcaption { font-size: 18px; }
    .figs div { grid-template-columns: 124px 1fr; }
  }
</style>
