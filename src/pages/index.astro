---
import Base from '../layouts/Base.astro';
const STRIPE_LINK = 'https://donate.stripe.com/REPLACE_ME';
---
<Base title="Home" immersive>
  <section class="world" id="world" data-stripe={STRIPE_LINK}>
    <canvas class="world-canvas" id="scene" aria-hidden="true"></canvas>
    <header class="hud">
      <a class="hud-brand" href="/"><img src="/logo.png" alt="" width="34" height="34" /><span>Free Meals on Wheels</span></a>
      <nav class="hud-nav">
        <button data-open="about">Our story</button>
        <button data-open="volunteer">Volunteer</button>
        <button data-open="resources">Get a meal</button>
        <button data-open="contact">Contact</button>
        <button class="hud-give" data-open="donate">Donate</button>
      </nav>
    </header>
    <div class="intro">
      <span class="eyebrow">San Jose and San Ramon · every Saturday</span>
      <h1>Dignity starts with a full belly.</h1>
      <p class="hint-desktop">Welcome to the truck. Drag to look around, click anyone to say hi.</p>
      <p class="hint-mobile">Swipe around the truck and tap what you need.</p>
    </div>
    <div class="labels" id="labels">
      <button data-station="volunteer"><i></i>Volunteer</button>
      <button data-station="donate"><i></i>Donate</button>
      <button data-station="about"><i></i>Our story</button>
      <button data-station="resources"><i></i>Get a meal</button>
      <button data-station="contact"><i></i>Contact</button>
    </div>
    <div class="swiper" id="swiper">
      <button id="prev" aria-label="Previous">‹</button>
      <span id="dots"></span>
      <button id="next" aria-label="Next">›</button>
    </div>
    <div class="quick">
      <button class="btn" data-open="volunteer">Volunteer</button>
      <button class="btn ghost" data-open="donate">Donate</button>
    </div>
    <aside class="pop" id="pop" aria-hidden="true" role="dialog" aria-labelledby="pop-title">
      <button class="pop-close" id="pop-close" aria-label="Back to the truck">×</button>
      <div id="pop-body"></div>
    </aside>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true"><filter id="chalky"><feTurbulence type="fractalNoise" baseFrequency="1.2" numOctaves="2" result="n"/><feDisplacementMap in="SourceGraphic" in2="n" scale="2.5"/></filter></svg>
    <section class="story" id="story" aria-hidden="true" aria-label="Our story">
      <div class="chalkboard">
        <button class="sheet-close" data-close aria-label="Back to the truck">×</button>
        <div class="chapters" id="chapters"></div>
        <nav class="story-nav">
          <button id="s-prev" aria-label="Previous">‹</button>
          <span id="s-dots"></span>
          <button id="s-next" aria-label="Next">›</button>
        </nav>
      </div>
    </section>
    <section class="board" id="board" aria-hidden="true" aria-label="Community board">
      <div class="cork">
        <button class="sheet-close" data-close aria-label="Back to the truck">×</button>
        <div class="pinned">
          <div class="paper title"><i class="pin"></i><h2>Community board</h2><p>Questions, ideas, a team that wants to help, or just a hello. It all goes here.</p></div>
          <a class="paper card" href="mailto:info@freemealsonwheels.com"><i class="pin"></i><small>Write to us</small><b>info@freemealsonwheels.com</b><span>A real person reads every note.</span></a>
          <a class="polaroid" href="https://www.instagram.com/freemealsonwheels/"><i class="tape"></i><img src="/img/smile.webp" alt="" loading="lazy" /><span>@freemealsonwheels</span></a>
          <a class="paper flyer green" href="mailto:info@freemealsonwheels.com?subject=Corporate%20team%20day"><i class="pin"></i><b>Bring your team</b><span>Cook and pack together on a Saturday. Great for companies, schools and clubs.</span></a>
          <a class="paper flyer peach" href="mailto:info@freemealsonwheels.com?subject=Blanket%20drive"><i class="pin"></i><b>Host a blanket drive</b><span>Every winter we pair a hot meal with a warm blanket.</span></a>
          <a class="paper note" href="https://www.facebook.com/Freemeals20/"><i class="pin"></i><b>Find us on Facebook</b><span>Free Meals on Wheels</span></a>
          <button class="paper note yellow" data-goto="resources"><i class="pin"></i><b>Need a meal?</b><span>There's a seat for you. Tap here.</span></button>
          <form class="paper letter" id="note-form"><i class="pin"></i><b>Leave a note for the volunteers</b><textarea name="note" rows="3" placeholder="They read these on Saturday morning."></textarea><button class="btn">Pin it</button></form>
        </div>
      </div>
    </section>
  </section>
</Base>

<script>
  import { mountTruck, type StationId } from '../lib/truck-scene';
  import { KITCHENS, ROLES, upcomingSaturdays, spotsLeft, book, type Kitchen, type RoleId } from '../lib/store';

  const ORDER: StationId[] = ['volunteer', 'donate', 'about', 'resources', 'contact'];
  const root = document.getElementById('world')!, pop = document.getElementById('pop')!, body = document.getElementById('pop-body')!;
  const STRIPE = root.dataset.stripe!;
  const labels = Object.fromEntries([...document.querySelectorAll<HTMLElement>('#labels button')].map((b) => [b.dataset.station, b])) as Record<StationId, HTMLElement>;
  const mobile = () => innerWidth < 760;
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
  const fmt = (d: string, o: Intl.DateTimeFormatOptions) => new Date(d + 'T12:00').toLocaleDateString('en-US', o);
  let idx = 0, openTimer = 0;

  const api = mountTruck(document.getElementById('scene') as HTMLCanvasElement, labels, (id) => open(id));
  if (!api) root.classList.add('no-gl');

  // Volunteer card: kitchen, Saturday, role, then a few fields. Confirmed on the spot.
  const vol = { kitchen: 'san_jose' as Kitchen, date: upcomingSaturdays()[0], role: null as RoleId | null, step: 'pick' as 'pick' | 'form' | 'done' };
  function volunteerCard() {
    if (vol.step === 'pick') {
      body.innerHTML = `
        <p class="kicker">This is the window. This could be you.</p><h2 id="pop-title">Pick a Saturday shift</h2>
        <div class="seg">${(Object.keys(KITCHENS) as Kitchen[]).map((k) => `<button data-k="${k}" aria-pressed="${k === vol.kitchen}">${KITCHENS[k]}</button>`).join('')}</div>
        <div class="dates">${upcomingSaturdays().map((d) => {
          const open = ROLES.reduce((n, r) => n + spotsLeft(vol.kitchen, d, r.id), 0);
          return `<button data-d="${d}" aria-pressed="${d === vol.date}"><small>${fmt(d, { month: 'short' })}</small><b>${fmt(d, { day: 'numeric' })}</b><em>${open ? open + ' open' : 'Full'}</em></button>`;
        }).join('')}</div>
        <div class="roles">${ROLES.map((r) => {
          const left = spotsLeft(vol.kitchen, vol.date, r.id);
          return `<button data-r="${r.id}"><span><b>${r.name}</b><small>${r.time}</small></span><em class="${left ? (left <= 2 ? 'low' : '') : 'full'}">${left ? left + ' left' : 'Waitlist'}</em></button>`;
        }).join('')}</div>`;
    } else if (vol.step === 'form') {
      const r = ROLES.find((x) => x.id === vol.role)!;
      body.innerHTML = `
        <button class="back" data-back>‹ Change shift</button>
        <h2 id="pop-title">${r.name}</h2>
        <p class="muted">${fmt(vol.date, { weekday: 'long', month: 'long', day: 'numeric' })} · ${r.time} · ${KITCHENS[vol.kitchen]}</p>
        <form id="vform">
          <label>Your name<input name="name" required autocomplete="name" /></label>
          <label>Email<input name="email" type="email" required autocomplete="email" /></label>
          <label>Phone (for day-of updates)<input name="phone" type="tel" autocomplete="tel" /></label>
          <div class="row">
            <label>People<select name="party">${[1, 2, 3, 4, 5, 6].map((n) => `<option>${n}</option>`).join('')}</select></label>
            <label class="check"><input type="checkbox" name="first" /> First time</label>
          </div>
          <button class="btn wide">Confirm my spot</button>
        </form>`;
    }
  }
  body.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button'); if (!b || !body.contains(b)) return;
    if (b.dataset.k) { vol.kitchen = b.dataset.k as Kitchen; volunteerCard(); }
    else if (b.dataset.d) { vol.date = b.dataset.d; volunteerCard(); }
    else if (b.dataset.r) { vol.role = b.dataset.r as RoleId; vol.step = 'form'; volunteerCard(); }
    else if ('back' in b.dataset || 'again' in b.dataset) { vol.step = 'pick'; volunteerCard(); }
    else if (b.dataset.amt) {
      body.querySelectorAll('[data-amt]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      const a = Number(b.dataset.amt), m = Math.floor(a / 10) || 1;
      api?.give(a);
      document.getElementById('meals')!.innerHTML = `That's <b>${m}</b> warm meal${m > 1 ? 's' : ''}, made with love on Saturday.`;
    }
  });
  body.addEventListener('submit', (e) => {
    e.preventDefault();
    const f = new FormData(e.target as HTMLFormElement), r = ROLES.find((x) => x.id === vol.role)!;
    const s = book({ kitchen: vol.kitchen, date: vol.date, role: r.id, name: String(f.get('name')), email: String(f.get('email')), phone: String(f.get('phone') || ''), party: Number(f.get('party')), firstTime: f.has('first') });
    vol.step = 'done';
    const [st, en] = r.time.split(' – ');
    const t = (x: string) => { const [hm, ap] = x.trim().split(' '); let [h, m] = hm.split(':').map(Number); if (ap === 'PM' && h < 12) h += 12; return vol.date.replace(/-/g, '') + 'T' + String(h).padStart(2, '0') + String(m).padStart(2, '0') + '00'; };
    const ics = `BEGIN:VCALENDAR\nVERSION:2.0\nBEGIN:VEVENT\nSUMMARY:Free Meals on Wheels · ${r.name}\nDTSTART:${t(st.includes('M') ? st : st + ' ' + en.split(' ')[1])}\nDTEND:${t(en)}\nLOCATION:${KITCHENS[vol.kitchen]} kitchen\nEND:VEVENT\nEND:VCALENDAR`;
    body.innerHTML = s.status === 'booked' ? `
      <div class="done"><span class="tick">✓</span><h2 id="pop-title">You're in, ${esc(s.name.split(' ')[0])}!</h2>
      <p class="muted">${r.name} · ${fmt(vol.date, { weekday: 'long', month: 'long', day: 'numeric' })} · ${r.time}. A confirmation is on its way to ${esc(s.email)}.</p>
      <a class="btn wide" download="free-meals-shift.ics" href="data:text/calendar;charset=utf-8,${encodeURIComponent(ics)}">Add to calendar</a>
      <button class="link" data-again>Book another shift</button></div>` : `
      <div class="done"><span class="tick wait">…</span><h2 id="pop-title">You're on the waitlist</h2>
      <p class="muted">That shift is full. We'll email ${esc(s.email)} the moment a spot opens.</p>
      <button class="link" data-again>Pick a different shift</button></div>`;
  });

  const CARDS: Record<Exclude<StationId, 'volunteer'>, () => string> = {
    donate: () => `
      <p class="kicker">Every coin is a warm dinner</p><h2 id="pop-title">Somebody eats tonight because of you</h2>
      <p class="muted">Tap an amount and watch it land. $10 covers a fresh, hot meal, and 100% goes to food.</p>
      <div class="amounts">${[10, 25, 50, 100, 250].map((a, i) => `<button data-amt="${a}" aria-pressed="${i === 1}">$${a}</button>`).join('')}</div>
      <p class="meals" id="meals">That's <b>2</b> warm meals, made with love on Saturday.</p>
      <a class="btn wide" href="${STRIPE}">Donate securely</a>
      <p class="fine">Payments by Stripe. One-time or monthly. Tax-deductible, we're a 501(c)(3).</p>`,
    about: () => `
      <p class="kicker">Our story</p><h2 id="pop-title">Neighbors feeding neighbors</h2>
      <p class="muted">Founded by Japjot Sethi and Devinder Kumar, Free Meals on Wheels cooks, packs and delivers fresh meals every Saturday from San Jose and San Ramon.</p>
      <div class="stats"><div><b>300+</b><small>meals a week</small></div><div><b>400+</b><small>volunteers</small></div><div><b>100%</b><small>to meals</small></div></div>
      <a class="link" href="/about">Read the full story →</a>`,
    resources: () => `
      <p class="kicker">Need a meal?</p><h2 id="pop-title">Sit down. This one's for you.</h2>
      <p class="muted">A fresh, hot meal, free for anyone who needs one. No forms, no questions, no one asking why. Just good food and good company.</p>
      <ul class="list"><li><b>Saturdays, 11 AM – 1 PM</b><small>Meals delivered across San Jose and San Ramon</small></li><li><b>Can't get out?</b><small>Email us and we'll add you to a delivery route</small></li></ul>
      <a class="btn wide" href="mailto:info@freemealsonwheels.com?subject=Meal%20delivery">Request a meal</a>
      <a class="link" href="/resources">More resources →</a>`,
    contact: () => `
      <p class="kicker">Say hello</p><h2 id="pop-title">We'd love to hear from you</h2>
      <ul class="list"><li><b>Email</b><a href="mailto:info@freemealsonwheels.com">info@freemealsonwheels.com</a></li>
      <li><b>Instagram</b><a href="https://www.instagram.com/freemealsonwheels/">@freemealsonwheels</a></li>
      <li><b>Facebook</b><a href="https://www.facebook.com/Freemeals20/">Free Meals on Wheels</a></li></ul>
      <a class="link" href="/contact">Corporate team days and partnerships →</a>`,
  };

  const sheets: Partial<Record<StationId, HTMLElement>> = { about: document.getElementById('story')!, contact: document.getElementById('board')! };
  function open(id: StationId) {
    idx = ORDER.indexOf(id); syncDots();
    closeSheets(); root.classList.remove('open');
    api?.focus(id);
    clearTimeout(openTimer);
    const sheet = sheets[id];
    if (sheet) {
      if (id === 'about') showChapter(0);
      openTimer = window.setTimeout(() => { root.classList.add('sheet'); sheet.classList.add('on'); sheet.setAttribute('aria-hidden', 'false'); }, api ? 1100 : 0);
    } else {
      if (id !== 'volunteer') body.innerHTML = CARDS[id]();
      else if (vol.step !== 'done' || !body.querySelector('.done')) { if (vol.step === 'done') vol.step = 'pick'; volunteerCard(); }
      openTimer = window.setTimeout(() => { root.classList.add('open'); pop.setAttribute('aria-hidden', 'false'); }, api ? 650 : 0);
    }
    history.replaceState(null, '', '#' + id);
  }
  function closeSheets() { for (const el of Object.values(sheets)) { el!.classList.remove('on'); el!.setAttribute('aria-hidden', 'true'); } root.classList.remove('sheet'); }
  function close() {
    clearTimeout(openTimer); closeSheets();
    root.classList.remove('open'); pop.setAttribute('aria-hidden', 'true');
    api?.focus(mobile() ? ORDER[idx] : null, true);
    history.replaceState(null, '', location.pathname);
  }
  document.querySelectorAll<HTMLElement>('[data-close]').forEach((b) => (b.onclick = close));
  document.querySelectorAll<HTMLElement>('[data-goto]').forEach((b) => (b.onclick = () => open(b.dataset.goto as StationId)));
  document.getElementById('note-form')!.addEventListener('submit', (e) => {
    e.preventDefault();
    const note = String(new FormData(e.target as HTMLFormElement).get('note') || '');
    location.href = `mailto:info@freemealsonwheels.com?subject=${encodeURIComponent('A note for the volunteers')}&body=${encodeURIComponent(note)}`;
  });

  // Our story: a chalkboard storyboard with taped-up photos.
  const SK = {
    friends: '<path d="M30 90c0-14 8-22 16-22s16 8 16 22M46 60a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM78 90c0-14 8-22 16-22s16 8 16 22M94 60a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM62 74c4-6 12-6 16 0M70 28c-4-6-14-2-10 6l10 9 10-9c4-8-6-12-10-6z"/>',
    bowl: '<path d="M24 62h92c0 18-20 32-46 32S24 80 24 62zM50 94h40M52 50c-6-8 6-12 0-22M70 50c-6-8 6-12 0-22M88 50c-6-8 6-12 0-22"/>',
    clock: '<circle cx="70" cy="60" r="34"/><path d="M70 38v22l14 10M70 26v4M104 60h-4M70 94v-4M36 60h4"/>',
    houses: '<path d="M18 92V58l22-18 22 18v34zM78 92V58l22-18 22 18v34zM62 74c6-8 10-8 16 0M32 92V74h16v18M92 92V74h16v18"/>',
    truck: '<path d="M14 82V44h66v38zM80 56h22l14 14v12H80zM30 92a8 8 0 1 0 0-16 8 8 0 0 0 0 16zM100 92a8 8 0 1 0 0-16 8 8 0 0 0 0 16zM30 62c6-6 12 6 18 0s12 6 18 0"/>',
    blanket: '<path d="M24 34h92v52H24zM24 50h92M24 70h92M44 34v52M70 34v52M96 34v52M60 22l4 6M80 18l-2 8M100 24l-4 6"/>',
    heart: '<path d="M70 96S20 66 20 40c0-14 10-22 22-22 12 0 20 8 28 18 8-10 16-18 28-18 12 0 22 8 22 22 0 26-50 56-50 56z"/>',
  };
  const CH = [
    { t: 'It started with two friends.', b: 'Japjot Sethi and Devinder Kumar believed no neighbor should go to bed hungry. So they started cooking.', sk: SK.friends, img: ['team.webp'] },
    { t: 'A hot meal is more than food.', b: '“A fresh, hot, and nutritious meal is not just satiating, but more importantly, enabling and liberating.”', sk: SK.bowl, img: ['smile.webp'] },
    { t: 'Every Saturday, the kitchen wakes up.', b: 'We cook at 7. We pack at 9:30. By 11, meals are on their way.', sk: SK.clock, img: ['kitchen.webp', 'boxes.jpg'] },
    { t: 'Two kitchens. One family.', b: 'San Jose and San Ramon, and more than 400 volunteers who show up with open hearts.', sk: SK.houses, img: ['serving.jpg'] },
    { t: '300+ meals, every single week.', b: 'Delivered by hand, still warm, with a smile and a name.', sk: SK.truck, img: ['handoff.jpg'] },
    { t: 'Warmth for winter.', b: 'When it gets cold, we pair a hot meal with a warm blanket. At Thanksgiving, everyone gets a seat at the table.', sk: SK.blanket, img: ['blanket.webp', 'thanksgiving.webp'] },
    { t: 'And now, you.', b: 'Every meal starts with someone who decided to care. That can be you this Saturday.', sk: SK.heart, img: [], cta: true },
  ];
  const chapters = document.getElementById('chapters')!, sdots = document.getElementById('s-dots')!;
  chapters.innerHTML = CH.map((c, i) => `
    <article class="chapter" data-i="${i}">
      <div class="chalk">
        <small>${i + 1} / ${CH.length}</small>
        <h2>${c.t}</h2><p>${c.b}</p>
        ${c.cta ? '<div class="cta"><button class="btn" data-goto="volunteer">Volunteer this Saturday</button><button class="btn ghost" data-goto="donate">Give a meal</button></div>' : ''}
      </div>
      <svg class="sketch" viewBox="0 0 140 110" aria-hidden="true"><g>${c.sk}</g></svg>
      <div class="photos">${c.img.map((src, k) => `<figure style="--r:${(k ? 4 : -3) + (i % 2 ? 2 : -1)}deg"><i class="tape"></i><img src="/img/${src}" alt="" loading="lazy" /></figure>`).join('')}</div>
    </article>`).join('');
  chapters.querySelectorAll<HTMLElement>('[data-goto]').forEach((b) => (b.onclick = () => open(b.dataset.goto as StationId)));
  sdots.innerHTML = CH.map(() => '<i></i>').join('');
  let ch = 0;
  function showChapter(i: number) {
    ch = Math.max(0, Math.min(CH.length - 1, i));
    chapters.querySelectorAll('.chapter').forEach((el, k) => { el.classList.toggle('on', k === ch); el.classList.toggle('past', k < ch); });
    [...sdots.children].forEach((d, k) => d.classList.toggle('on', k === ch));
  }
  document.getElementById('s-prev')!.onclick = () => showChapter(ch - 1);
  document.getElementById('s-next')!.onclick = () => showChapter(ch + 1);
  addEventListener('keydown', (e) => { if (!sheets.about!.classList.contains('on')) return; if (e.key === 'ArrowRight') showChapter(ch + 1); if (e.key === 'ArrowLeft') showChapter(ch - 1); });
  let csx = 0;
  sheets.about!.addEventListener('touchstart', (e) => { csx = e.touches[0].clientX; }, { passive: true });
  sheets.about!.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - csx; if (Math.abs(dx) > 50) showChapter(ch + (dx < 0 ? 1 : -1)); }, { passive: true });
  showChapter(0);

  for (const [id, el] of Object.entries(labels)) el.onclick = () => open(id as StationId);
  document.querySelectorAll<HTMLElement>('[data-open]').forEach((b) => (b.onclick = () => open(b.dataset.open as StationId)));
  document.getElementById('pop-close')!.onclick = close;
  addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });

  // Phones: swipe or use the arrows to walk around the truck.
  const dots = document.getElementById('dots')!;
  dots.innerHTML = ORDER.map(() => '<i></i>').join('');
  function syncDots() { [...dots.children].forEach((d, i) => d.classList.toggle('on', i === idx)); }
  function step(d: number) { idx = (idx + d + ORDER.length) % ORDER.length; syncDots(); api?.focus(ORDER[idx], true); }
  document.getElementById('prev')!.onclick = () => step(-1);
  document.getElementById('next')!.onclick = () => step(1);
  let sx = 0;
  root.addEventListener('touchstart', (e) => { sx = e.touches[0].clientX; }, { passive: true });
  root.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - sx;
    if (Math.abs(dx) > 50 && !root.classList.contains('open') && !root.classList.contains('sheet')) step(dx < 0 ? 1 : -1);
  }, { passive: true });
  const applyMode = () => { if (!root.classList.contains('open') && !root.classList.contains('sheet')) api?.focus(mobile() ? ORDER[idx] : null, true); };
  addEventListener('resize', applyMode); applyMode(); syncDots();
  root.querySelector('canvas')!.addEventListener('pointerdown', () => setTimeout(() => root.classList.add('moved'), 400), { once: true });
  const fromHash = location.hash.slice(1) as StationId;
  if (ORDER.includes(fromHash)) open(fromHash);
</script>

<style>
  :global(body.immersive) { overflow: hidden; }
  .world { position: relative; height: 100svh; min-height: 520px; overflow: hidden; background: #d9eaee; }
  .world-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; touch-action: pan-y; }
  .hud { position: absolute; z-index: 4; top: 16px; left: 16px; right: 16px; display: flex; justify-content: space-between; align-items: center; gap: 12px; pointer-events: none; }
  .hud > * { pointer-events: auto; }
  .hud-brand { display: flex; align-items: center; gap: 10px; padding: 6px 16px 6px 8px; border-radius: 999px; background: rgb(255 255 255 / .85); backdrop-filter: blur(12px); box-shadow: 0 6px 20px rgb(30 40 30 / .12); text-decoration: none; color: var(--green); font-weight: 650; letter-spacing: -.01em; }
  .hud-brand img { width: 34px; height: 34px; object-fit: cover; border-radius: 50%; background: #fff; }
  .hud-nav { display: flex; gap: 4px; padding: 5px; border-radius: 999px; background: rgb(255 255 255 / .85); backdrop-filter: blur(12px); box-shadow: 0 6px 20px rgb(30 40 30 / .12); }
  .hud-nav button { border: 0; background: none; padding: .55rem 1rem; border-radius: 999px; font: inherit; font-weight: 550; color: var(--ink); cursor: pointer; }
  .hud-nav button:hover { background: var(--tint); }
  .hud-nav .hud-give { background: var(--btn); color: #fff; box-shadow: var(--btn-shadow); }
