---
import Base from '../layouts/Base.astro';
---
<Base title="About us">
  <section class="wrap page-hero">
    <h1>About us</h1>
    <p class="lead">Free Meals on Wheels is a 501(c)(3) nonprofit founded by Japjot Sethi and Devinder Kumar. From kitchens in San Jose and San Ramon, 400+ volunteers serve 300+ meals every week.</p>
  </section>
  <section class="wrap section" style="padding-top:24px">
    <div class="grid"><article class="card"><h3>Dignity first</h3><p class="muted">We believe in the innate dignity of the human spirit, regardless of circumstances.</p></article><article class="card"><h3>Fresh, not frozen</h3><p class="muted">Meals are cooked the same morning they are delivered.</p></article><article class="card"><h3>Every dollar counts</h3><p class="muted">Every penny of every donation goes directly to meals.</p></article></div>
  </section>
</Base>
