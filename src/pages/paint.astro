---
// /paint: a painterly 2D landing-page variant. The home page (index.astro) is untouched.
const B = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const STRIPE_LINK = 'https://donate.stripe.com/REPLACE_ME';
const amounts = [10, 25, 50, 100, 250];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Free Meals on Wheels</title>
  <meta name="description" content="Free Meals on Wheels cooks and delivers free, fresh meals to neighbors in need across the Bay Area." />
  <link rel="icon" href={`${B}logo.png`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Kalam:wght@300;400&family=Figtree:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <script is:inline>document.documentElement.classList.add('js')</script>
</head>
<body>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
    <filter id="rough" x="-5%" y="-20%" width="110%" height="140%"><feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="4" result="n" /><feDisplacementMap in="SourceGraphic" in2="n" scale="5" /></filter>
    <filter id="rough2" x="-5%" y="-20%" width="110%" height="140%"><feTurbulence type="fractalNoise" baseFrequency="0.02" numOctaves="2" seed="9" result="n" /><feDisplacementMap in="SourceGraphic" in2="n" scale="3" /></filter>
  </svg>

  <section class="hero" id="top" data-hero>
    <canvas class="layer" id="bg" aria-hidden="true"></canvas>
    <canvas class="layer" id="stage" role="img" aria-label="Painted figures pass a meal bag from hand to hand to someone sitting alone, who stands up, and then everyone joins hands in the shape of a heart."></canvas>
    <header class="nav">
      <a href={B} class="brand"><img src={`${B}img/logo-heart.png`} alt="" width="40" height="36" /><span>Free Meals on Wheels</span></a>
      <nav aria-label="Main">
        <a href="#story" class="lk">Our story</a>
        <a href="#volunteer" class="lk">Volunteer</a>
        <a href="#meal" class="lk">Get a meal</a>
        <a href="#contact" class="lk">Contact</a>
        <a href={`${B}my-shifts`} class="lk login">Log in</a>
        <a href="#donate" class="pill">Donate</a>
      </nav>
    </header>
    <div class="copy">
      <p class="eyebrow">San Jose and San Ramon · every Saturday</p>
      <h1>Dignity starts with <em>a full belly.</em></h1>
      <p class="sub">Fresh meals, cooked the same morning and delivered by hand, still warm. Made by 400+ neighbors for neighbors.</p>
      <div class="actions">
        <a class="btn primary" href={`${B}volunteer`}><span>Volunteer</span></a>
        <a class="btn warm" href="#donate"><span>Donate</span></a>
        <a class="btn line" href="#meal"><span>Get a meal</span></a>
      </div>
    </div>
    <a class="scroll" href="#story" aria-label="Scroll to our story"><i></i></a>
  </section>

  <main>
    <section class="sec story" id="story">
      <div class="col text">
        <h2>Neighbors feeding neighbors.</h2>
        <p class="big">Every week, 400+ volunteers cook and pack 300+ meals, and every penny of every donation goes to food.</p>
        <p>Japjot Sethi and Devinder Kumar believed no neighbor should go to bed hungry, so they started cooking. Today Free Meals on Wheels is a 501(c)(3) nonprofit that cooks, packs and delivers fresh meals every Saturday from San Jose and San Ramon.</p>
        <blockquote>“A fresh, hot, and nutritious meal is not just satiating, but more importantly, enabling and liberating.”</blockquote>
        <dl class="values">
          <div><dt>Dignity first</dt><dd>We believe in the innate dignity of the human spirit, regardless of circumstances.</dd></div>
          <div><dt>Fresh, not frozen</dt><dd>Meals are cooked the same morning they are delivered.</dd></div>
          <div><dt>Every dollar counts</dt><dd>Every penny of every donation goes directly to meals.</dd></div>
        </dl>
        <a class="textlink" href={`${B}about`}>Read the full story</a>
      </div>
      <figure class="vig"><canvas data-scene="friends" aria-label="Two friends stir a pot together"></canvas></figure>
    </section>

    <section class="sec volunteer flip" id="volunteer">
      <div class="col text">
        <h2>Pick a Saturday shift. You're in.</h2>
        <p class="big">Choose a kitchen, a date and a role. Your spot is confirmed instantly, no waiting on an email back.</p>
        <ol class="day">
          <li><b>7:00</b><span>We cook.</span></li>
          <li><b>9:30</b><span>We pack.</span></li>
          <li><b>11:00</b><span>Meals are on their way.</span></li>
        </ol>
        <p>First time? Wear closed-toe shoes, tie back long hair and arrive 10 minutes early. We'll show you everything. Coming as a group of 7 or more, or a corporate day? <a href="mailto:info@freemealsonwheels.com?subject=Group%20volunteering">Email us</a>.</p>
        <div class="actions"><a class="btn primary" href={`${B}volunteer`}><span>Volunteer</span></a><a class="textlink" href={`${B}my-shifts`}>Already signed up? Log in</a></div>
      </div>
      <figure class="vig"><canvas data-scene="kitchen" aria-label="Volunteers pass meal bags down a table"></canvas></figure>
    </section>

    <section class="sec meal" id="meal">
      <div class="col text">
        <h2>Sit down. This one's for you.</h2>
        <p class="big">A fresh, hot meal, free for anyone who needs one. No forms, no questions, no one asking why. Just good food and good company.</p>
        <ul class="facts">
          <li><b>Saturdays, 11 AM – 1 PM</b><span>Meals delivered across San Jose and San Ramon</span></li>
          <li><b>Can't get out?</b><span>Email us with your name, address and how many people are in your household, and we'll add you to a delivery route.</span></li>
          <li><b>Need more help?</b><span>Dial 211 for food, housing and health services near you.</span></li>
        </ul>
        <div class="actions"><a class="btn line" href="mailto:info@freemealsonwheels.com?subject=Meal%20request"><span>Get a meal</span></a><a class="textlink" href={`${B}resources`}>More resources</a></div>
      </div>
      <figure class="vig"><canvas data-scene="table" aria-label="One person sets a warm bowl in front of another at a table"></canvas></figure>
    </section>

    <section class="sec donate flip" id="donate">
      <div class="col text">
        <h2>Somebody eats tonight because of you.</h2>
        <p class="big">$10 covers a fresh, hot meal, and 100% goes to food.</p>
        <div class="amounts" role="group" aria-label="Donation amount">
          {amounts.map((a, i) => <button type="button" data-amt={a} aria-pressed={i === 1}>${a}</button>)}
        </div>
        <p class="meals" id="meals" aria-live="polite">That's <b>2</b> warm meals, made with love on Saturday.</p>
        <p>When it gets cold, we pair a hot meal with a warm blanket. At Thanksgiving, everyone gets a seat at the table.</p>
        <div class="actions"><a class="btn warm" href={STRIPE_LINK}><span>Donate securely</span></a></div>
        <p class="fine">Payments by Stripe. One-time or monthly. Tax-deductible, we're a 501(c)(3).</p>
      </div>
      <figure class="vig"><canvas data-scene="blanket" aria-label="One person drapes a warm blanket over another's shoulders"></canvas></figure>
    </section>

    <section class="sec contact" id="contact">
      <div class="col text">
        <h2>We'd love to hear from you.</h2>
        <ul class="facts">
          <li><b>Email</b><span><a href="mailto:info@freemealsonwheels.com">info@freemealsonwheels.com</a></span></li>
          <li><b>Instagram</b><span><a href="https://www.instagram.com/freemealsonwheels/">@freemealsonwheels</a></span></li>
          <li><b>Facebook</b><span><a href="https://www.facebook.com/Freemeals20/">Free Meals on Wheels</a></span></li>
        </ul>
        <a class="textlink" href={`${B}contact`}>Corporate team days and partnerships</a>
      </div>
      <figure class="vig"><canvas data-scene="wave" aria-label="A few friends wave hello"></canvas></figure>
    </section>
  </main>

  <footer class="foot">
    <img src={`${B}img/logo-heart.png`} alt="" width="46" height="42" />
    <p>Free Meals on Wheels · a 501(c)(3) nonprofit · <a href="mailto:info@freemealsonwheels.com">info@freemealsonwheels.com</a></p>
    <p><a href={B}>Visit the 3D kitchen</a></p>
  </footer>

  <script>
    import { paperGrainURL } from '../lib/paint/engine';
    import { startHero } from '../lib/paint/hero';
    import { startVignettes } from '../lib/paint/vignettes';
    const q = new URLSearchParams(location.search);
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches || q.get('reduced') === '1';
    document.documentElement.style.setProperty('--grain', `url(${paperGrainURL()})`);
    const hero = document.querySelector<HTMLElement>('[data-hero]')!;
    const seek = q.has('t') ? Number(q.get('t')) : undefined;
    startHero(hero, hero.querySelector('#bg')!, hero.querySelector('#stage')!, { reduced, seek, freeze: q.has('freeze') });
    startVignettes(document.querySelectorAll<HTMLCanvasElement>('canvas[data-scene]'), { reduced, still: q.has('still') });
    // donate chips
    const meals = document.getElementById('meals')!;
    document.querySelectorAll<HTMLButtonElement>('[data-amt]').forEach((b) => b.addEventListener('click', () => {
      document.querySelectorAll('[data-amt]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      const m = Math.floor(Number(b.dataset.amt) / 10) || 1;
      meals.innerHTML = `That's <b>${m}</b> warm meal${m > 1 ? 's' : ''}, made with love on Saturday.`;
    }));
  </script>
</body>
</html>

<style is:global>
  :root {
    --paper: #f6f3ea; --ink: #1c2a24; --muted: #55635b; --green: #1f4d34; --green2: #2f6b4a; --orange: #e8681c; --coral: #e2705b; --gold: #e2c27a;
    --serif: 'Instrument Serif', Georgia, serif; --sans: Figtree, system-ui, sans-serif; --hand: Kalam, cursive;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; background: var(--paper) var(--grain, none); color: var(--ink); font: 400 18px/1.62 var(--sans); -webkit-font-smoothing: antialiased; overflow-x: hidden; }
  a { color: inherit; }
  img { display: block; max-width: 100%; }
  :focus-visible { outline: 2.5px solid var(--green2); outline-offset: 3px; border-radius: 6px; }

  /* hero */
  .hero { position: relative; height: 100svh; min-height: 640px; overflow: hidden; isolation: isolate; }
  .hero .layer { position: absolute; inset: 0; z-index: 0; }
  .nav { position: absolute; z-index: 5; top: 0; left: 0; right: 0; display: flex; justify-content: space-between; align-items: center; padding: 18px clamp(16px, 3.4vw, 44px); }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; font: 400 1.5rem/1 var(--serif); color: var(--green); }
  .brand img { width: 40px; height: 36px; object-fit: contain; }
  .nav nav { display: flex; align-items: center; gap: clamp(14px, 2vw, 30px); }
  .nav .lk { text-decoration: none; font-weight: 500; font-size: .98rem; color: var(--ink); padding: 6px 2px; background: linear-gradient(var(--coral), var(--coral)) 0 100% / 0 2px no-repeat; transition: background-size .35s; }
  .nav .lk:hover { background-size: 100% 2px; }
  .pill { position: relative; text-decoration: none; font-weight: 600; color: #fff; padding: .55rem 1.25rem; isolation: isolate; }
  .pill::before { content: ''; position: absolute; inset: 0; z-index: -1; background: var(--orange); border-radius: 999px; filter: url(#rough2); }
  .copy { position: absolute; z-index: 4; left: clamp(20px, 6vw, 96px); bottom: 50%; transform: translateY(50%); width: min(44vw, 620px); }
  .eyebrow { margin: 0 0 1rem; font: 400 1.25rem/1.2 var(--hand); color: var(--green2); }
  .copy h1 { margin: 0; font: 400 clamp(3.2rem, 6.6vw, 6.6rem)/.93 var(--serif); letter-spacing: -.015em; color: var(--green); text-wrap: balance; }
  .copy h1 em { font-style: italic; color: var(--green2); }
  .sub { margin: 1.4rem 0 1.8rem; max-width: 30rem; color: var(--muted); font-size: 1.12rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 14px 18px; align-items: center; }
  .btn { position: relative; display: inline-flex; text-decoration: none; font-weight: 600; font-size: 1.02rem; padding: .85rem 1.6rem; isolation: isolate; transition: transform .2s; }
  .btn::before { content: ''; position: absolute; inset: 0; z-index: -1; border-radius: 999px; filter: url(#rough); transition: transform .25s; }
  .btn:hover { transform: translateY(-2px) rotate(-.6deg); }
  .btn.primary { color: #fff; } .btn.primary::before { background: var(--green); }
  .btn.warm { color: #fff; } .btn.warm::before { background: var(--orange); }
  .btn.line { color: var(--green); } .btn.line::before { box-shadow: inset 0 0 0 2px var(--green); }
  .scroll { position: absolute; z-index: 5; left: 50%; bottom: 14px; width: 28px; height: 44px; translate: -50% 0; opacity: 0; transition: opacity 1s 1.8s; }
  .scroll i { position: absolute; left: 50%; top: 6px; width: 2px; height: 26px; background: var(--green2); opacity: .55; translate: -50% 0; transform-origin: top; animation: drip 2.4s ease-in-out infinite; }
  @keyframes drip { 0% { transform: scaleY(0); } 50% { transform: scaleY(1); } 100% { transform: scaleY(1); opacity: 0; } }
  .hero.settled .scroll { opacity: 1; }
  .js .copy > * { opacity: 0; transform: translateY(16px); }
  .js .hero.settled .copy > * { opacity: 1; transform: none; transition: opacity 1.1s cubic-bezier(.2, .7, .2, 1), transform 1.1s cubic-bezier(.2, .7, .2, 1); }
  .js .hero.settled .copy > :nth-child(2) { transition-delay: .15s; } .js .hero.settled .copy > :nth-child(3) { transition-delay: .45s; } .js .hero.settled .copy > :nth-child(4) { transition-delay: .65s; }
  @media (prefers-reduced-motion: reduce) { .js .copy > * { opacity: 1 !important; transform: none !important; } .scroll { opacity: 1; } .scroll i { animation: none; } }

  /* sections */
  .sec { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: clamp(28px, 5vw, 80px); align-items: center; width: min(1240px, 100% - 40px); margin: 0 auto; padding: clamp(64px, 10vw, 140px) 0; }
  .sec.flip .vig { order: -1; }
  .sec + .sec::before { content: ''; position: absolute; top: 0; left: 4%; right: 4%; height: 14px; background: linear-gradient(90deg, transparent, rgb(31 77 52 / .22) 14%, rgb(31 77 52 / .12) 60%, transparent); filter: url(#rough); opacity: .7; clip-path: polygon(0 50%, 100% 30%, 100% 60%, 0 80%); }
  .text { max-width: 34rem; }
  .sec h2 { margin: 0 0 1.1rem; font: 400 clamp(2.4rem, 4.6vw, 4rem)/1 var(--serif); letter-spacing: -.012em; color: var(--green); text-wrap: balance; }
  .big { font: 400 1.4rem/1.42 var(--serif); color: var(--ink); margin: 0 0 1.2rem; }
  .text p { margin: 0 0 1.1rem; }
  .text p a, .facts a { color: var(--green2); text-underline-offset: 3px; text-decoration-thickness: 1.5px; }
  .textlink { display: inline-block; font-weight: 600; color: var(--green); text-decoration: none; background: linear-gradient(var(--coral), var(--coral)) 0 100% / 100% 2px no-repeat; padding-bottom: 2px; transition: background-size .3s; }
  .textlink:hover { background-size: 0 2px; background-position: 100% 100%; }
  blockquote { margin: 1.6rem 0; padding: 0 0 0 1.2rem; border-left: 3px solid var(--gold); font: 400 1.45rem/1.35 var(--hand); color: var(--green2); }
  .values { margin: 1.8rem 0; display: grid; gap: 1rem; }
  .values dt { font-weight: 700; color: var(--green); } .values dd { margin: 0; color: var(--muted); }
  .day { list-style: none; margin: 1.4rem 0; padding: 0 0 0 22px; border-left: 2px dashed rgb(31 77 52 / .3); display: grid; gap: .6rem; }
  .day li { position: relative; display: flex; gap: 14px; align-items: baseline; }
  .day li::before { content: ''; position: absolute; left: -29px; top: .62em; width: 11px; height: 11px; border-radius: 50%; background: var(--coral); filter: url(#rough2); }
  .day b { font: 400 1.9rem/1 var(--serif); color: var(--green); min-width: 3.6rem; }
  .facts { list-style: none; margin: 1.6rem 0; padding: 0; display: grid; gap: 1.1rem; }
  .facts b { display: block; color: var(--green); font-weight: 700; } .facts span { color: var(--muted); }
  .amounts { display: flex; flex-wrap: wrap; gap: 10px; margin: 1.4rem 0 1rem; }
  .amounts button { font: 600 1.1rem var(--sans); color: var(--green); background: none; border: 0; padding: .6rem 1.15rem; position: relative; cursor: pointer; isolation: isolate; }
  .amounts button::before { content: ''; position: absolute; inset: 0; z-index: -1; border-radius: 999px; box-shadow: inset 0 0 0 2px rgb(31 77 52 / .35); filter: url(#rough2); transition: all .2s; }
  .amounts button[aria-pressed='true'] { color: #fff; } .amounts button[aria-pressed='true']::before { background: var(--green); box-shadow: none; }
  .meals { font: 400 1.5rem/1.3 var(--serif); color: var(--ink); } .meals b { color: var(--coral); font-weight: 400; }
  .fine { font-size: .85rem; color: var(--muted); margin-top: 1rem !important; }
  .vig { margin: 0; position: relative; aspect-ratio: 7 / 5; }
  .vig canvas { width: 100%; height: 100%; display: block; }
  .foot { display: grid; justify-items: center; gap: 6px; padding: 60px 20px 48px; text-align: center; color: var(--muted); font-size: .9rem; }
  .foot p { margin: 0; } .foot a { color: var(--green2); font-weight: 600; }

  @media (max-width: 860px) {
    .sec { grid-template-columns: 1fr; padding: 56px 0 72px; } .sec.flip .vig { order: 0; } .text { max-width: none; }
    .vig { order: -1; } .sec.flip .vig { order: -1; }
  }
  @media (max-width: 760px) {
    .nav .lk:not(.login) { display: none; } .brand span { display: none; }
    .copy { left: 20px; right: 20px; width: auto; bottom: 22px; transform: none; }
    .copy h1 { font-size: clamp(2.7rem, 12.4vw, 3.6rem); } .eyebrow { font-size: 1.05rem; margin-bottom: .6rem; }
    .sub { font-size: 1rem; margin: .9rem 0 1.1rem; } .actions { gap: 10px; } .btn { padding: .7rem 1.2rem; font-size: .96rem; }
    .scroll { display: none; }
  }
</style>
