---
import Base from '../layouts/Base.astro';
---
<Base title="Resources">
  <section class="wrap page-hero">
    <h1>Resources</h1>
    <p class="lead">Need a meal or know someone who does? We can help.</p>
  </section>
  <section class="wrap section" style="padding-top:24px">
    <div class="grid"><article class="card"><h3>Request meals</h3><p class="muted">Email us with your name, address and how many people are in your household.</p><a class="btn" href="mailto:info@freemealsonwheels.com?subject=Meal%20request">Request meals</a></article><article class="card"><h3>Bay Area help</h3><p class="muted">Dial 211 for food, housing and health services near you.</p></article></div>
  </section>
</Base>
