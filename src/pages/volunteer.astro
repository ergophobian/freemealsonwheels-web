---
import Base from '../layouts/Base.astro';
---
<Base title="Volunteer" description="Pick a Saturday shift and get a confirmed spot in under a minute.">
  <section class="wrap page-hero">
    <span class="eyebrow">Every Saturday</span>
    <h1>Pick a shift. You're in.</h1>
    <p class="lead">Choose a kitchen, a date and a role. Your spot is confirmed instantly, no waiting on an email back.</p>
  </section>

  <section class="wrap booking card" id="booking">
    <div id="step-pick">
      <div class="step">
        <h3><span class="num">1</span> Kitchen</h3>
        <div class="seg" id="kitchens"></div>
      </div>
      <div class="step">
        <h3><span class="num">2</span> Date</h3>
        <div class="dates" id="dates"></div>
      </div>
      <div class="step">
        <h3><span class="num">3</span> Role</h3>
        <div class="roles" id="roles"></div>
      </div>
    </div>

    <form id="step-form" hidden>
      <button type="button" class="back" id="back">← Change shift</button>
      <div class="summary" id="summary"></div>
      <div class="fields">
        <label>Full name<input name="name" required autocomplete="name" /></label>
        <label>Email<input name="email" type="email" required autocomplete="email" /></label>
        <label>Phone<input name="phone" type="tel" required autocomplete="tel" placeholder="For day-of updates" /></label>
        <label>People in your group
          <select name="party">{[1,2,3,4,5,6].map((n) => <option value={n}>{n}</option>)}</select>
        </label>
      </div>
      <label class="check"><input type="checkbox" name="firstTime" /> This is my first time volunteering</label>
      <button class="btn big" type="submit" id="submit">Confirm my spot</button>
      <p class="muted small">We'll email a confirmation and a reminder the day before.</p>
    </form>

    <div id="step-done" hidden class="done">
      <div class="tick">✓</div>
      <h2 id="done-title">You're in!</h2>
      <p class="lead" id="done-text"></p>
      <div class="actions">
        <a class="btn" id="ics" download="free-meals-shift.ics">Add to calendar</a>
        <button class="btn ghost" id="again" type="button">Book another shift</button>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid">
      <article class="card"><h3>First time?</h3><p class="muted">Wear closed-toe shoes, tie back long hair and arrive 10 minutes early. We'll show you everything.</p></article>
      <article class="card"><h3>Coming as a group?</h3><p class="muted">Pick your group size when you book. For 7 or more, or a corporate day, <a href="mailto:info@freemealsonwheels.com?subject=Group%20volunteering">email us</a>.</p></article>
      <article class="card"><h3>Can't make it?</h3><p class="muted">Reply to your confirmation email so we can give your spot to someone on the waitlist.</p></article>
    </div>
  </section>
</Base>

<script>
  import { KITCHENS, ROLES, upcomingSaturdays, spotsLeft, book, type Kitchen, type RoleId } from '../lib/store';

  const $ = (id: string) => document.getElementById(id)!;
  const fmt = (d: string, opts: Intl.DateTimeFormatOptions) => new Date(d + 'T12:00:00').toLocaleDateString('en-US', opts);
  const state: { kitchen: Kitchen; date: string; role?: RoleId } = { kitchen: 'san_jose', date: upcomingSaturdays()[0] };

  function render() {
    $('kitchens').innerHTML = (Object.keys(KITCHENS) as Kitchen[]).map((k) =>
      `<button type="button" data-k="${k}" aria-pressed="${k === state.kitchen}">${KITCHENS[k]}</button>`).join('');

    $('dates').innerHTML = upcomingSaturdays().map((d) => {
      const left = ROLES.reduce((n, r) => n + spotsLeft(state.kitchen, d, r.id), 0);
      return `<button type="button" data-d="${d}" aria-pressed="${d === state.date}">
        <small>${fmt(d, { weekday: 'short' })}</small><b>${fmt(d, { day: 'numeric' })}</b><small>${fmt(d, { month: 'short' })}</small>
        <em class="${left ? '' : 'full'}">${left ? left + ' open' : 'Full'}</em></button>`;
    }).join('');

    $('roles').innerHTML = ROLES.map((r) => {
      const left = spotsLeft(state.kitchen, state.date, r.id);
      const pct = 100 - (left / r.capacity) * 100;
      return `<button type="button" class="role" data-r="${r.id}">
        <div><b>${r.name}</b><span class="muted">${r.time}</span><span class="muted small">${r.note}</span></div>
        <div class="meter"><i style="width:${pct}%"></i></div>
        <span class="pill ${left ? (left <= 2 ? 'low' : '') : 'full'}">${left ? (left <= 2 ? `Only ${left} left` : `${left} spots left`) : 'Full · join waitlist'}</span>
      </button>`;
    }).join('');
  }

  function show(step: 'pick' | 'form' | 'done') {
    ($('step-pick') as HTMLElement).hidden = step !== 'pick';
    ($('step-form') as HTMLElement).hidden = step !== 'form';
    ($('step-done') as HTMLElement).hidden = step !== 'done';
    $('booking').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  $('kitchens').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button'); if (!b) return;
    state.kitchen = b.dataset.k as Kitchen; render();
  });
  $('dates').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button'); if (!b) return;
    state.date = b.dataset.d!; render();
  });
  $('roles').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button'); if (!b) return;
    state.role = b.dataset.r as RoleId;
    const r = ROLES.find((x) => x.id === state.role)!;
    const left = spotsLeft(state.kitchen, state.date, r.id);
    $('summary').innerHTML = `<b>${r.name}</b><span>${fmt(state.date, { weekday: 'long', month: 'long', day: 'numeric' })} · ${r.time}</span><span>${KITCHENS[state.kitchen]} kitchen</span>`;
    $('submit').textContent = left ? 'Confirm my spot' : 'Join the waitlist';
    show('form');
    (document.querySelector('#step-form input[name=name]') as HTMLInputElement).focus({ preventScroll: true });
  });
  $('back').addEventListener('click', () => show('pick'));
  $('again').addEventListener('click', () => { render(); show('pick'); });

  $('step-form').addEventListener('submit', (e) => {
    e.preventDefault();
    const f = new FormData(e.target as HTMLFormElement);
    const r = ROLES.find((x) => x.id === state.role)!;
    const s = book({
      kitchen: state.kitchen, date: state.date, role: r.id,
      name: String(f.get('name')).trim(), email: String(f.get('email')).trim(), phone: String(f.get('phone')).trim(),
      party: Number(f.get('party')), firstTime: f.get('firstTime') === 'on',
    });
    const when = `${fmt(s.date, { weekday: 'long', month: 'long', day: 'numeric' })}, ${r.time}`;
    $('done-title').textContent = s.status === 'booked' ? `You're in, ${s.name.split(' ')[0]}!` : "You're on the waitlist";
    $('done-text').textContent = s.status === 'booked'
      ? `${r.name} at our ${KITCHENS[s.kitchen]} kitchen, ${when}. A confirmation is on its way to ${s.email}.`
      : `${r.name} is full for ${when}. We'll text and email you the moment a spot opens.`;
    const [start] = r.time.split(' – ');
    const dt = (t: string) => { const [hm, ap] = t.split(' '); let [h, m] = hm.split(':').map(Number); if (ap === 'PM' && h !== 12) h += 12; return s.date.replace(/-/g, '') + 'T' + String(h).padStart(2, '0') + String(m).padStart(2, '0') + '00'; };
    const end = r.time.split(' – ')[1] ?? start;
    const ics = `BEGIN:VCALENDAR\nVERSION:2.0\nBEGIN:VEVENT\nSUMMARY:Free Meals on Wheels · ${r.name}\nDTSTART:${dt(start.includes('M') ? start : start + ' ' + end.split(' ')[1])}\nDTEND:${dt(end)}\nLOCATION:${KITCHENS[s.kitchen]} kitchen\nEND:VEVENT\nEND:VCALENDAR`;
    ($('ics') as HTMLAnchorElement).href = 'data:text/calendar;charset=utf-8,' + encodeURIComponent(ics);
    ($('ics') as HTMLElement).hidden = s.status !== 'booked';
    (e.target as HTMLFormElement).reset();
    show('done');
  });

  render();
</script>

<style>
  .booking { padding: clamp(20px, 4vw, 36px); scroll-margin-top: 84px; }
  .step + .step { margin-top: 28px; }
  .step h3 { display: flex; align-items: center; gap: .6rem; font-size: 1.05rem; }
  .num { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: var(--btn); color: #fff; font-size: .85rem; }
  .seg { display: inline-flex; padding: 4px; border-radius: 999px; background: rgb(15 18 34 / .05); }
  .seg :global(button) { border: 0; background: none; padding: .6rem 1.3rem; border-radius: 999px; font: inherit; font-weight: 600; color: var(--muted); cursor: pointer; }
  .seg :global(button[aria-pressed=true]) { background: #fff; color: var(--brand); box-shadow: 0 1px 3px rgb(20 30 80 / .15); }
  .dates { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(92px, 1fr); gap: 10px; overflow-x: auto; padding-bottom: 4px; }
  .dates :global(button) { display: grid; justify-items: center; gap: 2px; padding: 12px 8px; border-radius: 16px; border: 1.5px solid var(--line); background: rgb(255 255 255 / .6); font: inherit; color: var(--ink); cursor: pointer; transition: .15s; }
  .dates :global(button:hover) { border-color: rgb(47 63 232 / .35); }
  .dates :global(button[aria-pressed=true]) { border-color: var(--brand); background: rgb(47 63 232 / .06); box-shadow: 0 0 0 3px rgb(47 63 232 / .12); }
  .dates :global(b) { font-size: 1.6rem; line-height: 1.1; }
  .dates :global(small) { color: var(--muted); font-size: .8rem; }
  .dates :global(em) { font-style: normal; font-size: .75rem; color: #0e7c43; font-weight: 600; margin-top: 4px; }
  .dates :global(em.full) { color: var(--muted); }
  .roles { display: grid; gap: 12px; }
  .roles :global(.role) { display: grid; grid-template-columns: 1fr 140px auto; align-items: center; gap: 20px; text-align: left; padding: 18px 20px; border-radius: 16px; border: 1.5px solid var(--line); background: rgb(255 255 255 / .6); font: inherit; color: var(--ink); cursor: pointer; transition: .15s; }
  .roles :global(.role:hover) { border-color: var(--brand); transform: translateY(-1px); box-shadow: var(--shadow); }
  .roles :global(.role div:first-child) { display: grid; gap: 2px; }
  .roles :global(.meter) { height: 6px; border-radius: 9px; background: rgb(15 18 34 / .08); overflow: hidden; }
  .roles :global(.meter i) { display: block; height: 100%; background: var(--btn); }
  .roles :global(.pill) { font-size: .85rem; font-weight: 600; padding: .35rem .8rem; border-radius: 999px; background: rgb(14 124 67 / .1); color: #0e7c43; white-space: nowrap; }
  .roles :global(.pill.low) { background: rgb(245 179 1 / .18); color: #8a5a00; }
  .roles :global(.pill.full) { background: rgb(15 18 34 / .06); color: var(--muted); }
  @media (max-width: 680px) { .roles :global(.role) { grid-template-columns: 1fr; gap: 10px; } }

  .back { border: 0; background: none; color: var(--brand); font: inherit; font-weight: 600; cursor: pointer; padding: 0; margin-bottom: 16px; }
  .summary { display: grid; gap: 2px; padding: 16px 18px; border-radius: 16px; background: rgb(47 63 232 / .06); margin-bottom: 20px; }
  .summary :global(span) { color: var(--muted); }
  .fields { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  @media (max-width: 600px) { .fields { grid-template-columns: 1fr; } }
  label { display: grid; gap: 6px; font-weight: 500; font-size: .95rem; }
  input, select { font: inherit; padding: .8rem 1rem; border-radius: 12px; border: 1.5px solid var(--line); background: rgb(255 255 255 / .85); color: var(--ink); }
  input:focus, select:focus { outline: none; border-color: var(--brand); box-shadow: 0 0 0 4px rgb(47 63 232 / .12); }
  .check { display: flex; align-items: center; gap: .6rem; margin: 18px 0; font-weight: 400; }
  .check input { width: 18px; height: 18px; }
  .big { width: 100%; justify-content: center; padding: 1rem; font-size: 1.05rem; }

  .done { text-align: center; padding: 20px 0; }
  .done .lead { margin-inline: auto; }
  .tick { width: 64px; height: 64px; margin: 0 auto 16px; border-radius: 50%; display: grid; place-items: center; background: rgb(14 124 67 / .12); color: #0e7c43; font-size: 2rem; }
  .actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-top: 20px; }
</style>
