---
// Top bar shared by every page: the logo, the name set as in the logo, the main links and the Donate button.
interface Props { active?: 'about' | 'volunteer' | 'get-a-meal' | 'contact' | 'donate' | 'my-shifts' | '' }
const { active = '' } = Astro.props;
const B = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const links = [
  ['about', 'Our story', `${B}about`],
  ['volunteer', 'Volunteer', `${B}volunteer`],
  ['get-a-meal', 'Get a meal', `${B}get-a-meal`],
  ['contact', 'Contact', `${B}contact`],
];
---
<header class="nav">
  <a class="brand" href={B} aria-label="Free Meals on Wheels, home">
    <img src={`${B}img/logo-heart.png`} alt="" width="320" height="284" />
    <span>Free Meals on Wheels<small>Bringing smiles, one meal at a time</small></span>
  </a>
  <nav aria-label="Main">
    {links.map(([id, label, href]) => <a href={href} aria-current={active === id ? 'page' : undefined}>{label}</a>)}
  </nav>
  <a class="give" href={`${B}donate`} aria-current={active === 'donate' ? 'page' : undefined}>Donate</a>
</header>
